[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_NATION_ASHEN_WOLD_DISPLAY_NAME": "The Ashen Wold",
"LOC_NATION_MARSHAL_DESCRIPTION_1": "Commands nothing that can be counted. The Marshal may close the river crossings and call the levy, and the levy is answered by people who may say no; what the Marshal has is authority over passage, never authority over a body.",
"LOC_NATION_MARSHAL_DESCRIPTION_2": "The only seat that touches a number, and it still grants recognition rather than power: the Reeve is recognised on the body the province actually maintains, which is a percent on the holder's own growth rather than a flat that would be decisive at one realm and rounding to nothing at another.",
"LOC_NATION_MARSHAL_DESCRIPTION_3": "One seat, and on this build it is the one nobody has sat in for two generations. It exists to be legible when vacant, which is why an absent holder is a visible row with its own tone and never a zero.",
"LOC_NATION_MARSHAL_DESCRIPTION_4": "More than one at a time, because an audit nobody can replace is a private accounting rather than an office. Three may sit at once and the fourth is refused on capacity, which is a different refusal from the single-seat Marshal's and produces a different situation for whoever is refused.",
"LOC_NATION_MARSHAL_DESCRIPTION_5": "Holds the granaries and recognises nothing else. An office with an empty allowlist is legal content and projects no modifier at all, which is how a polity can have a seat whose whole purpose is administrative.",
"LOC_NATION_MARSHAL_DESCRIPTION_6": "A river polity that governs where water can be crossed rather than who owns it. Its seats are filled from sects that were never related to one another, and its land is a claim over places that may be contested by anyone holding the standing to contest them.",
"LOC_NATION_MARSHAL_DISPLAY_NAME_1": "Marshal of the March",
"LOC_NATION_MARSHAL_DISPLAY_NAME_2": "Reeve of the Nine Provinces",
"LOC_NATION_MARSHAL_DISPLAY_NAME_3": "Keeper of the River Lantern",
"LOC_NATION_MARSHAL_DISPLAY_NAME_4": "Auditor of Tributes",
"LOC_NATION_MARSHAL_DISPLAY_NAME_5": "Quartermaster of the Wold",
"LOC_NATION_MARSHAL_DISPLAY_NAME_6": "The March of the Nine Provinces",
"LOC_NATION_NINE_PROVINCE_REACH_DISPLAY_NAME": "The Nine-Province Reach",
"LOC_NATION_RIVER_MARCH_DISPLAY_NAME": "The River March",
"LOC_NATION_STAR_COURT_DISPLAY_NAME": "The Star Court",
"LOC_NATION_STAR_REGENT_DESCRIPTION_1": "Sits where the crown is claimed to sit, which is a claim and not a crown. The Regent may name a seat and may not take one: every appointment goes through a trial the Regent cannot judge, which is what stops the highest office from being self-perpetuating.",
"LOC_NATION_STAR_REGENT_DESCRIPTION_2": "Recognised on the ear rather than the back. The Reader decides which doctrine tier a case may be heard under, which is ACCESS and never power: the office opens a shelf and grants nothing on the other side of it.",
"LOC_NATION_STAR_REGENT_DESCRIPTION_3": "Two at a time, so neither can refuse the other's order alone. The pair may together dissolve an office, which is the only way this build dissolves one, and never dissolves a person.",
"LOC_NATION_STAR_REGENT_DESCRIPTION_4": "The seat that is always empty and is never going to be filled on this build. It exists because a polity whose highest seat has never been occupied is a legible fact about that polity, and hiding the row would say the office does not exist.",
"LOC_NATION_STAR_REGENT_DESCRIPTION_5": "A highland polity that governs by precedent rather than by water. It holds the crown claim over the Star Court and no claim at all over the lowlands, so a war with the March is fought over a territory neither of them currently holds.",
"LOC_NATION_STAR_REGENT_DISPLAY_NAME_1": "Star Regent",
"LOC_NATION_STAR_REGENT_DISPLAY_NAME_2": "Reader of the Law",
"LOC_NATION_STAR_REGENT_DISPLAY_NAME_3": "Marshal of the Court",
"LOC_NATION_STAR_REGENT_DISPLAY_NAME_4": "Hermit of the Outer Seat",
"LOC_NATION_STAR_REGENT_DISPLAY_NAME_5": "The Court of the Star",
}
