[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_NPC_079C179B55": "a passer-by",
"LOC_NPC_100B455471": "Minor",
"LOC_NPC_28D7146C1D": "Known",
"LOC_NPC_2D553A2664": "has no opinion of you, and says so",
"LOC_NPC_45D5BC5A65": "Transient",
"LOC_NPC_4E9F7A31EE": "Present",
"LOC_NPC_735EBAB8F2": "nods once and goes back to what they were doing",
"LOC_NPC_86B4BA2FF9": "Story",
"LOC_NPC_8A52ED17C5": "Major",
"LOC_NPC_BC7819B34F": "Unknown",
"LOC_NPC_C1FBD4DC8B": "keeps their eyes on their own work",
"LOC_NPC_CD66EB8B1D": "standing about",
"LOC_NPC_COURTING_ELDER_BO_BODY_1": "nods once and looks past you at the road, which is a thing he does to everyone",
"LOC_NPC_COURTING_ELDER_BO_BODY_2": "asks you a question he already knows the answer to, so the conversation has no end in it",
"LOC_NPC_COURTING_ELDER_BO_BODY_3": "stops watching the door and looks at you instead, which you have not seen him do for anyone",
"LOC_NPC_COURTING_ELDER_BO_DISPLAY_NAME_1": "Kept At A Distance",
"LOC_NPC_COURTING_ELDER_BO_DISPLAY_NAME_2": "Declared",
"LOC_NPC_COURTING_ELDER_BO_DISPLAY_NAME_3": "Answered",
"LOC_NPC_COURTING_ELDER_BO_DISPLAY_NAME_4": "Bo of the Ninth House",
"LOC_NPC_COURTING_ELDER_BO_PROSE": "the winter the road closed — you came through with their brother on your sword and you never once looked at him",
"LOC_NPC_DB8A06EFCA": "someone at %s",
"LOC_NPC_DRIFTER_DISPLAY_NAME": "A Drifter",
"LOC_NPC_ELDER_QIN_DISPLAY_NAME_1": "Seated",
"LOC_NPC_ELDER_QIN_DISPLAY_NAME_2": "Standing Surety",
"LOC_NPC_ELDER_QIN_DISPLAY_NAME_3": "Elder Qin",
"LOC_NPC_ELDER_WEI_BODY_1": "nods once, the way you nod at weather",
"LOC_NPC_ELDER_WEI_BODY_2": "takes the cup in both hands, which he does not do for guests",
"LOC_NPC_ELDER_WEI_DISPLAY_NAME_1": "Gatekeeper",
"LOC_NPC_ELDER_WEI_DISPLAY_NAME_2": "Sworn Servant",
"LOC_NPC_ELDER_WEI_DISPLAY_NAME_3": "Retired",
"LOC_NPC_ELDER_WEI_DISPLAY_NAME_4": "Elder Wei",
"LOC_NPC_ELDER_WEI_PROSE_1": "Qin teaches that a promise is a debt and a debt is a chain. I teach that it is a door.",
"LOC_NPC_ELDER_WEI_PROSE_2": "the grey one, third month of the grey year — you walked past my gate while I was burying my brother, and you did not stop",
"LOC_NPC_FD2963A2D3": "does not look up from what they are doing",
"LOC_NPC_GATE_KEEPER_BO_DISPLAY_NAME_1": "Silent",
"LOC_NPC_GATE_KEEPER_BO_DISPLAY_NAME_2": "Watching",
"LOC_NPC_GATE_KEEPER_BO_DISPLAY_NAME_3": "Gatekeeper Bo",
"LOC_NPC_QI_DAO_ACTIVITIES_1": "sweeping the same stone over and over",
"LOC_NPC_QI_DAO_ACTIVITIES_2": "waiting for a name to be called",
"LOC_NPC_QI_DAO_ACTIVITIES_3": "mending a hinge that does not need it",
"LOC_NPC_QI_DAO_ACTIVITIES_4": "carrying water that is not needed",
"LOC_NPC_QI_DAO_BODY": "looks at your hands first, and only then at your face",
"LOC_NPC_QI_DAO_MANNERS_1": "counts something under her breath",
"LOC_NPC_QI_DAO_MANNERS_2": "stands where he can see the road",
"LOC_NPC_QI_DAO_MANNERS_3": "watches the hinge instead of you",
"LOC_NPC_QI_DAO_MANNERS_4": "does not stop walking but slows",
"LOC_NPC_QI_DAO_NAMES_1": "the woman sweeping",
"LOC_NPC_QI_DAO_NAMES_2": "the boy on the steps",
"LOC_NPC_QI_DAO_NAMES_3": "the man mending the hinge",
"LOC_NPC_QI_DAO_NAMES_4": "the girl carrying water",
"LOC_NPC_QI_DAO_PROSE": "the sect counts your hours and calls the ledger a virtue",
"LOC_NPC_SMITH_BEARCUTTER_DISPLAY_NAME_1": "Stranger",
"LOC_NPC_SMITH_BEARCUTTER_DISPLAY_NAME_2": "Trusted Smith",
"LOC_NPC_SMITH_BEARCUTTER_DISPLAY_NAME_3": "Smith Bearcutter",
}
