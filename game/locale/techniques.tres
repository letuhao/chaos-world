[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_TECHNIQUES_BODY_CARAPACE_FORM_DESCRIPTION": "Hardens the outer frame until qi runs along it like wire. Half elemental, so the form holds against wood and cracks against fire.",
"LOC_TECHNIQUES_BODY_CARAPACE_FORM_DISPLAY_NAME": "Carapace Form",
"LOC_TECHNIQUES_BODY_CRANE_DANCE_DESCRIPTION": "Seven weight shifts a breath apart, each one still balanced. Mostly raw mechanics with the wind qi woven through, so it is a footwork art first and an element second.",
"LOC_TECHNIQUES_BODY_CRANE_DANCE_DISPLAY_NAME": "Crane Dance Step",
"LOC_TECHNIQUES_BODY_IRON_SKIN_DESCRIPTION": "Drives qi into the fascia until the skin stops being soft. Barely elemental, so it reads as blunt force taken rather than a strike dealt.",
"LOC_TECHNIQUES_BODY_IRON_SKIN_DISPLAY_NAME": "Iron Skin",
"LOC_TECHNIQUES_BODY_STONE_ANCHOR_DESCRIPTION": "A stance that spends the whole body's weight instead of its speed. No qi, no element; it exists so the practitioner cannot be moved while it is held.",
"LOC_TECHNIQUES_BODY_STONE_ANCHOR_DISPLAY_NAME": "Stone Anchor Stance",
"LOC_TECHNIQUES_BODY_THUNDER_CLAW_DESCRIPTION": "Discharges from the point of contact outward through the target's own frame. Almost pure lightning riding a physical grip; the deepest body technique in the tree.",
"LOC_TECHNIQUES_BODY_THUNDER_CLAW_DISPLAY_NAME": "Thunder Claw",
"LOC_TECHNIQUES_BODY_TIGER_PALM_DESCRIPTION": "A short palm driven off the heel with nothing elemental in it at all. Every point of its output is raw body mass, so no element matchup can blunt it.",
"LOC_TECHNIQUES_BODY_TIGER_PALM_DISPLAY_NAME": "Tiger Palm",
"LOC_TECHNIQUES_BODY_TREMOR_CADENCE_DESCRIPTION": "Sends a resonance down through whatever the practitioner is standing on. Ground-carried, so it finds the feet before it finds the chest.",
"LOC_TECHNIQUES_BODY_TREMOR_CADENCE_DISPLAY_NAME": "Tremor Cadence",
"LOC_TECHNIQUES_DUAL_BODY_MIND_QUIET_PULSE_DESCRIPTION": "Slows the heartbeat and the attention in the same count, which neither half can do alone. Barely elemental; almost all of it is the recovery itself.",
"LOC_TECHNIQUES_DUAL_BODY_MIND_QUIET_PULSE_DISPLAY_NAME": "Quiet Pulse",
"LOC_TECHNIQUES_DUAL_BODY_MIND_STEEL_RECOLLECTION_DESCRIPTION": "The body repeats a movement the mind still remembers exactly. Purely raw output and no elemental term at all, so nothing resists it; the price is that both paths must already be at the Immortal floor.",
"LOC_TECHNIQUES_DUAL_BODY_MIND_STEEL_RECOLLECTION_DISPLAY_NAME": "Steel Recollection",
"LOC_TECHNIQUES_DUAL_BODY_MIND_UNBROKEN_CENTRE_DESCRIPTION": "Keeps the body's repair budget and the mind's attention in the same reserve. General regeneration and perception, the one passive a mortal-graded build can still reach on either path.",
"LOC_TECHNIQUES_DUAL_BODY_MIND_UNBROKEN_CENTRE_DISPLAY_NAME": "Unbroken Centre",
"LOC_TECHNIQUES_DUAL_BODY_MIND_UNNAMED_ORDER_DESCRIPTION": "A lineage of posture drill kept for three hundred years because nobody could name why it worked. Muscle fibre and mental defence, the only dual passive that pays a raw structural option beside a defensive one, and it needs both paths at the top of the ladder to learn.",
"LOC_TECHNIQUES_DUAL_BODY_MIND_UNNAMED_ORDER_DISPLAY_NAME": "Unnamed Order",
"LOC_TECHNIQUES_DUAL_QI_BODY_IRON_MARROW_DESCRIPTION": "Runs qi through the marrow rather than around the muscle, so the blow carries the weight of both halves. Six tenths metal: weak against fire, strong against wood.",
"LOC_TECHNIQUES_DUAL_QI_BODY_IRON_MARROW_DISPLAY_NAME": "Iron Marrow",
"LOC_TECHNIQUES_DUAL_QI_BODY_METAL_LATTICE_DESCRIPTION": "Stiffens the frame into a lattice qi can be stored in, which is why the technique holds a target in place rather than moving it. Both paths have to be deep.",
"LOC_TECHNIQUES_DUAL_QI_BODY_METAL_LATTICE_DISPLAY_NAME": "Metal Lattice",
"LOC_TECHNIQUES_DUAL_QI_BODY_STOUT_ROOT_DESCRIPTION": "Fuses the dantian's reservoir into the skeleton so the body stops being a separate machine. Denser bone and a deeper dantian: the only passive carrying one structural option and one qi option together.",
"LOC_TECHNIQUES_DUAL_QI_BODY_STOUT_ROOT_DISPLAY_NAME": "Stout Root",
"LOC_TECHNIQUES_DUAL_QI_BODY_TEMPERED_FRAME_DESCRIPTION": "Repeatedly loads a qi-filled frame until the frame absorbs what the qi cannot. Greater carry and organ vitality, paid for in stamina every minute it is equipped.",
"LOC_TECHNIQUES_DUAL_QI_BODY_TEMPERED_FRAME_DISPLAY_NAME": "Tempered Frame",
"LOC_TECHNIQUES_DUAL_QI_MIND_BOTH_EYES_OPEN_DESCRIPTION": "Trains the practitioner to notice the body's warning and the mind's misreading in the same instant. Perception doubled, on the one cadence only a dual path has.",
"LOC_TECHNIQUES_DUAL_QI_MIND_BOTH_EYES_OPEN_DISPLAY_NAME": "Both Eyes Open",
"LOC_TECHNIQUES_DUAL_QI_MIND_CLARITY_EDGE_DESCRIPTION": "Strikes with qi held perfectly still, which only a mind that cannot be startled can do. Mostly light, so a dark-veined body takes it badly.",
"LOC_TECHNIQUES_DUAL_QI_MIND_CLARITY_EDGE_DISPLAY_NAME": "Clarity Edge",
"LOC_TECHNIQUES_DUAL_QI_MIND_HARMONY_CADENCE_DESCRIPTION": "A counting pattern that keeps the two halves from drifting apart over a long practice. Steadier qi control and slightly better dual-path progress; it is the only passive that pays qi control AND a dual-path rate.",
"LOC_TECHNIQUES_DUAL_QI_MIND_HARMONY_CADENCE_DISPLAY_NAME": "Harmony Cadence",
"LOC_TECHNIQUES_DUAL_QI_MIND_SHARED_PULSE_DESCRIPTION": "Runs one circuit from the dantian up through the mind and back, so each half feeds the other. Unelemental, so there is no matchup to read, and both paths must be at the floor before it can be learned.",
"LOC_TECHNIQUES_DUAL_QI_MIND_SHARED_PULSE_DISPLAY_NAME": "Shared Pulse",
"LOC_TECHNIQUES_MIND_ABYSSAL_DROWN_DESCRIPTION": "Floods a mind's own recall until it cannot separate a real memory from a planted one. Two thirds water, so fire burns the flood out and an empty mind drowns in nothing.",
"LOC_TECHNIQUES_MIND_ABYSSAL_DROWN_DISPLAY_NAME": "Abyssal Drown",
"LOC_TECHNIQUES_MIND_GLARE_OF_WARDING_DESCRIPTION": "Returns an attacker's own attention back along the line it arrived on. Half light, so it is strong against dark and indifferent to everything else.",
"LOC_TECHNIQUES_MIND_GLARE_OF_WARDING_DISPLAY_NAME": "Glare of Warding",
"LOC_TECHNIQUES_MIND_ILLUSION_LATTICE_DESCRIPTION": "Builds a lattice of false readings and leaves it standing around the practitioner. Unelemental, sustained, and priced by clarity rather than by qi.",
"LOC_TECHNIQUES_MIND_ILLUSION_LATTICE_DISPLAY_NAME": "Illusion Lattice",
"LOC_TECHNIQUES_MIND_MIRROR_REVERSAL_DESCRIPTION": "Splits an incoming impression and sends half of it back down the same path. A dark reflection, so it is weakest against light and best against its own kind.",
"LOC_TECHNIQUES_MIND_MIRROR_REVERSAL_DISPLAY_NAME": "Mirror Reversal",
"LOC_TECHNIQUES_MIND_PRIME_AUTOPSY_DESCRIPTION": "Walks a hostile intention back to the first decision that produced it. Entirely dark: nothing resists it except light, and the qi bill is the steepest in the mind tree.",
"LOC_TECHNIQUES_MIND_PRIME_AUTOPSY_DISPLAY_NAME": "Prime Autopsy",
"LOC_TECHNIQUES_MIND_REVELATION_LANCE_DESCRIPTION": "A single named fact, driven hard enough to be believed. Almost pure light and carried on the intent rather than the will, so it lands on illusions and sceptics alike.",
"LOC_TECHNIQUES_MIND_REVELATION_LANCE_DISPLAY_NAME": "Revelation Lance",
"LOC_TECHNIQUES_MIND_STILL_WATER_DESCRIPTION": "Flattens the surface of the mind so an incoming impression has nothing to break against. Almost no element, because it does no damage to anybody.",
"LOC_TECHNIQUES_MIND_STILL_WATER_DISPLAY_NAME": "Still Water",
"LOC_TECHNIQUES_PASSIVE_BARRIER_CULTIVATION_DESCRIPTION": "Practises holding a wall up while deliberately having it struck. Mental defence and resistance to illusion, trained as two separate muscles.",
"LOC_TECHNIQUES_PASSIVE_BARRIER_CULTIVATION_DISPLAY_NAME": "Barrier Cultivation",
"LOC_TECHNIQUES_PASSIVE_CHAOS_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the chaos root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_CHAOS_ROOT_REFINING_DISPLAY_NAME": "Chaos Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_CLEAR_MIND_DESCRIPTION": "A daily sitting that empties the head before the day starts. A sharper read on the room; it is the cheapest passive in the codex.",
"LOC_TECHNIQUES_PASSIVE_CLEAR_MIND_DISPLAY_NAME": "Clear Mind Sitting",
"LOC_TECHNIQUES_PASSIVE_DANTIAN_RESERVOIR_DESCRIPTION": "A drawing and breathing scheme for holding qi in the lower field without straining. Deeper reservoir and steadier regrowth; it grants no power at all.",
"LOC_TECHNIQUES_PASSIVE_DANTIAN_RESERVOIR_DISPLAY_NAME": "Dantian Reservoir Manual",
"LOC_TECHNIQUES_PASSIVE_DARK_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the dark root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_DARK_ROOT_REFINING_DISPLAY_NAME": "Dark Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_EARTH_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the earth root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_EARTH_ROOT_REFINING_DISPLAY_NAME": "Earth Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_ECHO_RESONANCE_DESCRIPTION": "Records how a qi technique felt at its best and how to reproduce that exact state on demand. The notes raise technique power and perception together.",
"LOC_TECHNIQUES_PASSIVE_ECHO_RESONANCE_DISPLAY_NAME": "Echo Resonance Notes",
"LOC_TECHNIQUES_PASSIVE_FIRE_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the fire root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_FIRE_ROOT_REFINING_DISPLAY_NAME": "Fire Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_ICE_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the ice root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_ICE_ROOT_REFINING_DISPLAY_NAME": "Ice Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_LIGHTNING_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the lightning root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_LIGHTNING_ROOT_REFINING_DISPLAY_NAME": "Lightning Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_LIGHT_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the light root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_LIGHT_ROOT_REFINING_DISPLAY_NAME": "Light Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_MARROW_CIRCULATION_DESCRIPTION": "Teaches qi to take the short route through the long bones. Steadier qi control and better affinity to outside energy, and nothing that helps a strike land.",
"LOC_TECHNIQUES_PASSIVE_MARROW_CIRCULATION_DISPLAY_NAME": "Marrow Circulation Primer",
"LOC_TECHNIQUES_PASSIVE_METAL_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the metal root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_METAL_ROOT_REFINING_DISPLAY_NAME": "Metal Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_OSTEOMANTIC_FRAME_DESCRIPTION": "A loading routine for the long bones. Denser skeleton and better muscle fibre; a practitioner who trains this hits harder and still does not cast qi.",
"LOC_TECHNIQUES_PASSIVE_OSTEOMANTIC_FRAME_DISPLAY_NAME": "Osteomantic Frame",
"LOC_TECHNIQUES_PASSIVE_QUICK_REACTION_DESCRIPTION": "Repetition at speed until the first answer arrives before the question finishes. Dodge chance and mental attack, which is what a technique-carrying duellist wants.",
"LOC_TECHNIQUES_PASSIVE_QUICK_REACTION_DISPLAY_NAME": "Quick Reaction Drill",
"LOC_TECHNIQUES_PASSIVE_SECOND_WIND_DESCRIPTION": "Trains the body to keep a larger share of its load, so less of each effort has to be paid for out of qi. Greater carry and faster recovery than the frame it sits on.",
"LOC_TECHNIQUES_PASSIVE_SECOND_WIND_DISPLAY_NAME": "Second Wind Discipline",
"LOC_TECHNIQUES_PASSIVE_STILL_POINT_DESCRIPTION": "A discipline of holding the qi still at the moment of release. Every technique casts cheaper for it, which is the one thing that compounds at mastery.",
"LOC_TECHNIQUES_PASSIVE_STILL_POINT_DISPLAY_NAME": "Still Point",
"LOC_TECHNIQUES_PASSIVE_TIME_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the time root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_TIME_ROOT_REFINING_DISPLAY_NAME": "Time Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_VITAL_ORGAN_CYCLE_DESCRIPTION": "A breathing cycle that keeps the organs supplied under strain. Organ vitality and general regeneration, bought with a slow, dull price that has to be paid forever.",
"LOC_TECHNIQUES_PASSIVE_VITAL_ORGAN_CYCLE_DISPLAY_NAME": "Vital Organ Cycle",
"LOC_TECHNIQUES_PASSIVE_VOID_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the void root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_VOID_ROOT_REFINING_DISPLAY_NAME": "Void Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_WATER_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the water root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_WATER_ROOT_REFINING_DISPLAY_NAME": "Water Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_WIND_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the wind root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_WIND_ROOT_REFINING_DISPLAY_NAME": "Wind Root Refining Art",
"LOC_TECHNIQUES_PASSIVE_WOOD_ROOT_REFINING_DESCRIPTION": "A breathing art that opens the wood root to a body born without it, and deepens it by degrees.",
"LOC_TECHNIQUES_PASSIVE_WOOD_ROOT_REFINING_DISPLAY_NAME": "Wood Root Refining Art",
"LOC_TECHNIQUES_QI_CHAOS_EDICT_DESCRIPTION": "A decree with no author. What lands is never twice the same affliction, and the target's own body chooses which.",
"LOC_TECHNIQUES_QI_CHAOS_EDICT_DISPLAY_NAME": "Chaos Edict",
"LOC_TECHNIQUES_QI_CINDER_LANCE_DESCRIPTION": "A narrow spear of fire that overheats the air it crosses. Almost all of it is elemental, so fire resistance eats the hit and water doubles what gets through.",
"LOC_TECHNIQUES_QI_CINDER_LANCE_DISPLAY_NAME": "Cinder Lance",
"LOC_TECHNIQUES_QI_FROST_ANCHOR_DESCRIPTION": "Locks a standing pool of cold in place rather than throwing it. The qi stays where it is put, which is what makes it a control art instead of a damage one.",
"LOC_TECHNIQUES_QI_FROST_ANCHOR_DISPLAY_NAME": "Frost Anchor",
"LOC_TECHNIQUES_QI_GALE_STEP_DESCRIPTION": "A short lateral displacement on a current of air. Half of the qi leaves as raw momentum, so it costs less to move than to strike.",
"LOC_TECHNIQUES_QI_GALE_STEP_DISPLAY_NAME": "Gale Step",
"LOC_TECHNIQUES_QI_HEAVENLY_GLARE_DESCRIPTION": "Every particle of the technique is light, with no raw share to soften it. The highest ceiling in the tree and the steepest qi bill that goes with it.",
"LOC_TECHNIQUES_QI_HEAVENLY_GLARE_DISPLAY_NAME": "Heavenly Glare",
"LOC_TECHNIQUES_QI_MARROW_SURGE_DESCRIPTION": "Forces qi down the opened channels all at once instead of spending it evenly. Raw output, no element, so nothing resists it and nothing amplifies it either.",
"LOC_TECHNIQUES_QI_MARROW_SURGE_DISPLAY_NAME": "Marrow Surge",
"LOC_TECHNIQUES_QI_METAL_EDGE_DESCRIPTION": "Collapses a year of refined qi into one hard line. The sharpest thing a mortal hand can throw, and the cheapest way to find out what metal actually overcomes.",
"LOC_TECHNIQUES_QI_METAL_EDGE_DISPLAY_NAME": "Metal Edge",
"LOC_TECHNIQUES_QI_SERPENT_RAIN_DESCRIPTION": "Condenses falling moisture into a field of downward strokes. Three quarters elemental: strong against fire, thin against anything that drinks.",
"LOC_TECHNIQUES_QI_SERPENT_RAIN_DISPLAY_NAME": "Serpent Rain",
"LOC_TECHNIQUES_QI_STONEHEART_GRASP_DESCRIPTION": "Closes a fist of packed earth around a single foe. Wood pries it apart; water runs around it and survives less well than it hoped.",
"LOC_TECHNIQUES_QI_STONEHEART_GRASP_DISPLAY_NAME": "Stoneheart Grasp",
"LOC_TECHNIQUES_QI_THUNDER_SEVERING_DESCRIPTION": "A discharge so brief it has no travel time worth naming. Almost pure elemental, so it is the technique most worth mastering rather than the cheapest one to cast.",
"LOC_TECHNIQUES_QI_THUNDER_SEVERING_DISPLAY_NAME": "Thunder Severing",
"LOC_TECHNIQUES_QI_TIME_ARREST_DESCRIPTION": "The blow arrives before its sound. For a breath the target moves through honey, and every motion costs more than it did.",
"LOC_TECHNIQUES_QI_TIME_ARREST_DISPLAY_NAME": "Time Arrest",
"LOC_TECHNIQUES_QI_VERDANT_COIL_DESCRIPTION": "Whips living qi into a binding knot of thorned vine. Most of it is elemental: metal cuts it apart, and a body that drinks takes the thorns poorly.",
"LOC_TECHNIQUES_QI_VERDANT_COIL_DISPLAY_NAME": "Verdant Coil",
"LOC_TECHNIQUES_QI_VOID_ERASURE_DESCRIPTION": "The strike does not cut; it unmakes. Qi leaves the wound before blood does, and the seam it leaves remembers nothing.",
"LOC_TECHNIQUES_QI_VOID_ERASURE_DISPLAY_NAME": "Void Erasure",
"LOC_TECHNIQUES_QI_VOID_NEEDLE_DESCRIPTION": "Sends one thread of qi past a body's defences instead of through them. Dark is strong against light and nothing else, so it is a specialist answer, not a default.",
"LOC_TECHNIQUES_QI_VOID_NEEDLE_DISPLAY_NAME": "Void Needle",
"LOC_TECHNIQUES_SHARED_BONE_MENDING_SPLINT_DESCRIPTION": "Splints and knits a fracture between one breath and the next. Pure restoration; the qi goes into the mend and none of it comes back as a strike.",
"LOC_TECHNIQUES_SHARED_BONE_MENDING_SPLINT_DISPLAY_NAME": "Bone Mending Splint",
"LOC_TECHNIQUES_SHARED_ESSENCE_RESERVE_METHOD_DESCRIPTION": "Teaches both halves of the body to bank what they take in rather than spending it at once. Deeper essence and faster recovery, bought with a universal slot.",
"LOC_TECHNIQUES_SHARED_ESSENCE_RESERVE_METHOD_DISPLAY_NAME": "Essence Reserve Method",
"LOC_TECHNIQUES_SHARED_FOOTWORK_BASICS_DESCRIPTION": "Where the feet go when nothing else is happening. Unelemental and cheap, but it takes a universal slot, which is a slot a path technique could have used.",
"LOC_TECHNIQUES_SHARED_FOOTWORK_BASICS_DISPLAY_NAME": "Footwork Basics",
"LOC_TECHNIQUES_SHARED_QI_RECOVERY_BREATH_DESCRIPTION": "A five-breath pattern that returns a usable amount of qi in a few seconds. Unelemental, restorative, and gated on the best path rather than any one of them.",
"LOC_TECHNIQUES_SHARED_QI_RECOVERY_BREATH_DISPLAY_NAME": "Recovery Breath",
"LOC_TECHNIQUES_SHARED_TEMPERED_WILL_DESCRIPTION": "A discipline for holding a decision through the moment it hurts. Harden the will and lift the spirit that carries it; the only passive that reaches so high from the shared pool.",
"LOC_TECHNIQUES_SHARED_TEMPERED_WILL_DISPLAY_NAME": "Tempered Will",
"LOC_TECHNIQUES_SHARED_WOUND_PRESSURE_DESCRIPTION": "Sets qi into an injury to slow the bleed instead of treating it. Does almost no damage and keeps a badly hurt practitioner conscious, which is its whole use.",
"LOC_TECHNIQUES_SHARED_WOUND_PRESSURE_DISPLAY_NAME": "Wound Pressure Points",
}
