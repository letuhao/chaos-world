[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_EVENT_AUCTION_AT_THE_IMMORTAL_COURT_DESCRIPTION": "What the Court has no use for and cannot refuse to be seen selling. The lots, the bids and the hammer are this event's; what a lot actually resolves to is the market's, and the coins move there. Nothing here prices anything.",
"LOC_EVENT_AUCTION_AT_THE_IMMORTAL_COURT_DISPLAY_NAME_1": "The Lots Are Read",
"LOC_EVENT_AUCTION_AT_THE_IMMORTAL_COURT_DISPLAY_NAME_2": "Bids Open",
"LOC_EVENT_AUCTION_AT_THE_IMMORTAL_COURT_DISPLAY_NAME_3": "The Hammer Falls",
"LOC_EVENT_AUCTION_AT_THE_IMMORTAL_COURT_DISPLAY_NAME_4": "The Auction at the Immortal Court",
"LOC_EVENT_BEAST_TIDE_OF_THE_MORTAL_PLAINS_DESCRIPTION": "The ironhide herds come down out of the hills twice a year and the plain counts the cost. This event is the tide's own shape — the moving, the breaking, the dispersing — and the world remembers what it did about it. No animal is fought here; the slaying happens where combat lives.",
"LOC_EVENT_BEAST_TIDE_OF_THE_MORTAL_PLAINS_DISPLAY_NAME_1": "The Herd Is Moving",
"LOC_EVENT_BEAST_TIDE_OF_THE_MORTAL_PLAINS_DISPLAY_NAME_2": "Onto the Plain",
"LOC_EVENT_BEAST_TIDE_OF_THE_MORTAL_PLAINS_DISPLAY_NAME_3": "Dispersed",
"LOC_EVENT_BEAST_TIDE_OF_THE_MORTAL_PLAINS_DISPLAY_NAME_4": "Beast Tide of the Mortal Plains",
"LOC_EVENT_THE_DAWN_DESCENT_DESCRIPTION": "They came up out of the void crystal seams at the hour the Court has nobody left to count. Gated on what the world already remembers rather than on a summons, because the dead do not file invitations. The fighting is combat's; this is the shape of the week it took.",
"LOC_EVENT_THE_DAWN_DESCENT_DISPLAY_NAME_1": "Something Is At The Gate",
"LOC_EVENT_THE_DAWN_DESCENT_DISPLAY_NAME_2": "In The Court",
"LOC_EVENT_THE_DAWN_DESCENT_DISPLAY_NAME_3": "Driven Out",
"LOC_EVENT_THE_DAWN_DESCENT_DISPLAY_NAME_4": "The Dawn Descent",
"LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DESCRIPTION": "An elder takes a petition, and then a favour, and the third one is the one that changes what he is to you. The world records that it happened; the ROSTER counts it, through NpcApi.tally, where elder_wei's gatekeeper stage names advance_after = 3 and advance_verb = \"favours\". The final stage is the other half of the ladder: its beat names \"oaths_sworn\", which is what elder_wei's SWORN SERVANT rung counts (advance_after = 5), and without it the elder tops out one rung below the story he is written for. Nothing here decides a stage — the roster's own thresholds do, and a beat naming any other verb cannot walk him up his ladder.",
"LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_1": "The Petition Is Heard",
"LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_2": "The Favour Is Owed",
"LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_3": "The Oath Is Sworn",
"LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_4": "The Favour of Elder Wei",
"LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DESCRIPTION": "The eastern peak came apart in one afternoon and stayed broken. Gated on the same weather the plain's beast tide waits on, because a disaster nobody could walk into is not a disaster: this trigger names a real precondition the world produces, so an actor standing in the spirit peaks still has to have been there when the front arrived.",
"LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_1": "The Peaks Riven",
"LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_2": "Holding",
"LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_3": "Aftermath",
"LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_4": "The Riven Peak",
"LOC_EVENT_THE_STONE_THAT_ANSWERING_DESCRIPTION": "A dao fragment that answers when it is read, once, and then stops. One stage, because one reading is the whole event: `EventApi.begin` refuses an event that authors no stage (`event_authors_no_stage`), so the empty ladder that used to sit here was not a minimal shape — it was an event nothing could ever open. NOT TRIGGER-GATED, and that is the ADR 0217 shape: the `none_of(fact treasure_stone_read)` gate this event used to carry demanded a fact produced only by its OWN stage 0, which fails the SATISFIABLE test because the only producer is the door the gate is attached to. It was also a gate that was already OPEN on a bare hero, which fails the NON-TRIVIAL test for the same reason — a discovery does not announce itself, and the thing standing in the transcendent realm is the discovery's own condition. The once-rule is NOT lost with the gate: `EventApi.begin` and `EventApi.available` both refuse a resolved event (`already_resolved`), so the ledger owns 'read once' where it already did.",
"LOC_EVENT_THE_STONE_THAT_ANSWERING_DISPLAY_NAME_1": "It Answers, Once",
"LOC_EVENT_THE_STONE_THAT_ANSWERING_DISPLAY_NAME_2": "The Stone That Answering",
"LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DESCRIPTION": "Every three years the sects who can reach the peaks send one entrant, and every three years somebody wins the mountain. This event decides WHO ENTERED and HOW FAR THE LADDER GOT. The exchanges themselves were fought elsewhere, and the winner arrives at the final as a verdict from outside.",
"LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_1": "The Register Closes",
"LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_2": "The First Round",
"LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_3": "The Final",
"LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_4": "The Tournament of the Spirit Peaks",
"LOC_EVENT_WAR_OF_THE_NINE_FORDS_DESCRIPTION": "The March and the Court of the Star have declared over the River March. Both sides know what is at stake: the ford seats and the standing that rides on them. Nothing here decides the war. A verdict comes from outside, and the tally and the prize belong to the polity that declared them.",
"LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_1": "Levies Called",
"LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_2": "The Fords Are Held",
"LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_3": "The Verdict Is Read",
"LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_4": "War of the Nine Fords",
}
