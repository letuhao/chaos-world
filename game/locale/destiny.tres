[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_DESTINY_ANCESTRAL_DEBT_UNPAID_DESCRIPTION": "Entered a blood-feud household and left without settling the account. The clan marks the balance against the line, not against the person.",
"LOC_DESTINY_ANCESTRAL_DEBT_UNPAID_DISPLAY_NAME": "Unpaid Ancestral Debt",
"LOC_DESTINY_BOUND_NAME_CALLED_ONCE_DESCRIPTION": "Bound another's cultivation to your own, and that person died before the term expired. The binding resolved as written, which the sect regards as the least remarkable possible outcome.",
"LOC_DESTINY_BOUND_NAME_CALLED_ONCE_DISPLAY_NAME": "The Name Spoken Once",
"LOC_DESTINY_BOUND_NAME_CALLED_ONCE_TEASER": "One line in the ledger names two people. The second line is the sect's.",
"LOC_DESTINY_DEBT_CARRIED_FORWARD_DESCRIPTION": "This body did not walk here under its own power. Somebody else finished the journey, and the account of it did not close with them. It is still open, and the name on it is still yours.",
"LOC_DESTINY_DEBT_CARRIED_FORWARD_DISPLAY_NAME": "Debt Carried Forward",
"LOC_DESTINY_FIRST_BLOOD_DUEL_DESCRIPTION": "Opened a duel and closed it, alone, without assistance. The sect's record names no second party because the second party filed nothing.",
"LOC_DESTINY_FIRST_BLOOD_DUEL_DISPLAY_NAME": "First Blood",
"LOC_DESTINY_HEAVEN_EYE_CIRCLED_ONCE_DESCRIPTION": "Counted once among the marked. The count is per lifetime, not per attempt. Whether it is a rank or an observation is a matter the archive declines to settle.",
"LOC_DESTINY_HEAVEN_EYE_CIRCLED_ONCE_DISPLAY_NAME": "The Circled Eye",
"LOC_DESTINY_HEAVEN_S_CHOSEN_INSTRUMENT_DESCRIPTION": "Marked from outside by a discipline the sect does not teach. The mark reads as an instruction. It has never been explained and does not answer to argument.",
"LOC_DESTINY_HEAVEN_S_CHOSEN_INSTRUMENT_DISPLAY_NAME": "Heaven's Chosen Instrument",
"LOC_DESTINY_HEAVEN_S_WARNING_UNREAD_DESCRIPTION": "Received a communication the heavens do not explain and did not carry out. The sect logs the delay and leaves the item open.",
"LOC_DESTINY_HEAVEN_S_WARNING_UNREAD_DISPLAY_NAME": "An Unread Instruction",
"LOC_DESTINY_HEAVEN_S_WARNING_UNREAD_TEASER": "Something arrived. The archive does not say what.",
"LOC_DESTINY_HOUSEHOLD_REGISTERED_AS_HEIR_DESCRIPTION": "Named in a household register with no living elder of that line. The sect countersigned it because a name in a register is cheaper than a succession dispute.",
"LOC_DESTINY_HOUSEHOLD_REGISTERED_AS_HEIR_DISPLAY_NAME": "Registered as Heir",
"LOC_DESTINY_MERIDIAN_CUT_AT_THE_SHOULDER_DESCRIPTION": "A channel opened in order to be carried, then closed at the shoulder. The method is permanent, repeatable and widely documented. It is performed anyway.",
"LOC_DESTINY_MERIDIAN_CUT_AT_THE_SHOULDER_DISPLAY_NAME": "Cut at the Shoulder",
"LOC_DESTINY_NIGHT_OFF_THE_ROTATION_DESCRIPTION": "Left the post you were assigned and did not return to it. The roster carries the gap. It has not been reassigned.",
"LOC_DESTINY_NIGHT_OFF_THE_ROTATION_DISPLAY_NAME": "Night off the Rotation",
"LOC_DESTINY_OATH_BREAKER_DESCRIPTION": "Witnessed swearing an oath and witnessed breaking it, both in the same quarter hour. The sect records the second event. It keeps no file on the first.",
"LOC_DESTINY_OATH_BREAKER_DISPLAY_NAME": "Oath-Breaker",
"LOC_DESTINY_OATH_KEPT_UNDER_WITNESS_DESCRIPTION": "Three sworn terms discharged in full with named witnesses standing by. No clerk had to intervene. The body settles into a discipline the mind did not ask for.",
"LOC_DESTINY_OATH_KEPT_UNDER_WITNESS_DISPLAY_NAME": "Kept Under Witness",
"LOC_DESTINY_OATH_OF_THE_EMPTY_HAND_DESCRIPTION": "Sworn on a blade turned flat-side up, before witnesses, to strike nothing that has asked for mercy. The oath does not check whether the world agrees.",
"LOC_DESTINY_OATH_OF_THE_EMPTY_HAND_DISPLAY_NAME": "Oath of the Empty Hand",
"LOC_DESTINY_ONE_HUNDREDTH_SLAIN_DESCRIPTION": "One hundred dead, counted by the sect and not by the hand. The record closes a ledger nobody asked it to open. It takes no further note.",
"LOC_DESTINY_ONE_HUNDREDTH_SLAIN_DISPLAY_NAME": "The Hundredth",
"LOC_DESTINY_REBORN_IN_A_LESSER_VESSEL_DESCRIPTION": "Came back after a failure at the barrier in a body the sect records as a downgrade. The technique survived. The archive notes the discrepancy and declines to reconcile it.",
"LOC_DESTINY_REBORN_IN_A_LESSER_VESSEL_DISPLAY_NAME": "Reborn in a Lesser Vessel",
"LOC_DESTINY_REMEMBERED_BY_THE_MOUNTAIN_DESCRIPTION": "Walked into a forbidden ridge and came back with the ridge's name in your mouth. Nobody has asked where you learned it. You have not offered.",
"LOC_DESTINY_REMEMBERED_BY_THE_MOUNTAIN_DISPLAY_NAME": "Remembered by the Mountain",
"LOC_DESTINY_SOUL_MARKED_ONCE_DESCRIPTION": "The first time the body stopped and something kept going. Nobody witnessed it. The record of it is a single line, and the line has your name on it.",
"LOC_DESTINY_SOUL_MARKED_ONCE_DISPLAY_NAME": "Soul Marked Once",
"LOC_DESTINY_SOUL_MARKED_THRICE_DESCRIPTION": "Three bodies, three lines in the same column, written in an order only you can reconstruct. The record of what you were now outlives the body doing the recording, and the two are no longer the same size.",
"LOC_DESTINY_SOUL_MARKED_THRICE_DISPLAY_NAME": "Soul Marked Thrice",
"LOC_DESTINY_SOUL_MARKED_TWICE_DESCRIPTION": "Twice now the line has been written, and written by the same hand each time. The second mark is not the first one again; it is the first one acknowledged.",
"LOC_DESTINY_SOUL_MARKED_TWICE_DISPLAY_NAME": "Soul Marked Twice",
"LOC_DESTINY_THE_CHOSEN_INSTRUMENT_DESCRIPTION": "Heaven named a tool and the tool was made of you. The sect trains you accordingly, on the assumption that the instruction will not be withdrawn.",
"LOC_DESTINY_THE_CHOSEN_INSTRUMENT_DISPLAY_NAME": "The Chosen Instrument",
"LOC_DESTINY_THE_OATH_BOUND_DESCRIPTION": "Sworn into an order whose terms outlive the person who wrote them. Where the order's clerks remain, you remain.",
"LOC_DESTINY_THE_OATH_BOUND_DISPLAY_NAME": "The Oath-Bound",
"LOC_DESTINY_THE_ONE_WHO_RETURNED_DESCRIPTION": "Walked into a place the register does not admit and came back out with a working method and no account of how long the absence lasted.",
"LOC_DESTINY_THE_ONE_WHO_RETURNED_DISPLAY_NAME": "The One Who Returned",
"LOC_DESTINY_THE_ONE_WHO_STAYED_DESCRIPTION": "Held a post through the full rotation, alone, without relief and without complaint. The register shows a blank where a rotation should read. That blank is the record.",
"LOC_DESTINY_THE_ONE_WHO_STAYED_DISPLAY_NAME": "The One Who Stayed",
"LOC_DESTINY_THE_SEVERED_DESCRIPTION": "Carried a channel that was not yours to close, and closed it. The lineage that taught you the technique is no longer able to teach it.",
"LOC_DESTINY_THE_SEVERED_DISPLAY_NAME": "The Severed",
"LOC_DESTINY_THE_SEVERED_TEASER": "There is a gap in the lineage chart where a name should be. The chart does not say whose name.",
"LOC_DESTINY_THE_THIRD_MAN_SPARED_DESCRIPTION": "Stood at killing distance with the advantage held and did not close. The sect files this as an incomplete hunt, not as mercy.",
"LOC_DESTINY_THE_THIRD_MAN_SPARED_DISPLAY_NAME": "The Third Man Spared",
"LOC_DESTINY_THE_THIRD_MAN_SPARED_TEASER": "The roll is in the ledger. It has been there a while.",
"LOC_DESTINY_VIGIL_BROKEN_BY_HAND_DESCRIPTION": "Came off the wall mid-watch to settle a private matter. The wall held. Two of its dead were not the reason anyone remembers you.",
"LOC_DESTINY_VIGIL_BROKEN_BY_HAND_DISPLAY_NAME": "Vigil Broken by Hand",
}
