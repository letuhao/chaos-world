messages = {
"LOC_UI_PANELS_0C5D8C6003": "No sit length is published by the clock.",
"LOC_UI_PANELS_1230074BDC": "The world's events are not published to this screen",
"LOC_UI_PANELS_17753763A2": "The world has no clock",
"LOC_UI_PANELS_18FEB73E8B": "What is happening in the world",
"LOC_UI_PANELS_2948F603C6": "No period has passed yet.",
"LOC_UI_PANELS_5ACDF79B27": "The world's news (nothing heard)",
"LOC_UI_PANELS_6476B66F57": "This screen cannot ask for a longer sit",
"LOC_UI_PANELS_66222545E1": "No event is open. The world is waiting on its next one.",
"LOC_UI_PANELS_6A5ACB6459": "Sit (the world moves while you do)",
"LOC_UI_PANELS_6B48266C7B": "This screen is not wired to the world clock",
"LOC_UI_PANELS_7B66B4A655": "Choose how long to sit.",
"LOC_UI_PANELS_8208317A74": "The world remembers nothing yet.",
"LOC_UI_PANELS_8C6B2C3AB4": "The world has no one to remember it",
"LOC_UI_PANELS_9C7608368A": "Wait a season",
"LOC_UI_PANELS_9D2BC3DE40": "Sit for this long",
"LOC_UI_PANELS_A0D1357B51": "Something is open, and this screen cannot name it",
"LOC_UI_PANELS_A870B91DB2": "An open event arrived with no name. This screen cannot say which.",
"LOC_UI_PANELS_AA1371E549": "No world event row reaches this screen; it cannot say what is open.",
"LOC_UI_PANELS_AB0911EF8D": "Nothing is happening in the world right now",
"LOC_UI_PANELS_BAD9895BED": "The world's cadence is not published here.",
"LOC_UI_PANELS_C0199FC7CA": "No one is listening for what happens",
"LOC_UI_PANELS_C9D9CF171D": "No world clock is wired to this screen.",
"LOC_UI_PANELS_DFE3923CC6": " (unavailable)",
"LOC_UI_PANELS_EE322903D3": "A season passes",
"LOC_UI_PANELS_EE78098BE8": "The clock cannot cover a sit that long, and will not shorten it",
