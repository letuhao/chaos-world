[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_SETS_GILDED_BONE_PACT_DESCRIPTION": "A transcendent-band pact filed in bone. Each threshold settles one more entry against the wearer's breakthrough record.",
"LOC_SETS_GILDED_BONE_PACT_DISPLAY_NAME": "Gilded Bone Pact",
"LOC_SETS_IRONHIDE_VIGIL_DESCRIPTION": "A mortal-band vigil kit. Two members hold the line, five hold the gate; the body-tempering signature is the set's own, not a member's.",
"LOC_SETS_IRONHIDE_VIGIL_DISPLAY_NAME": "Ironhide Vigil",
"LOC_SETS_SET_GILDED_BONE_CHARM_DESCRIPTION": "A bone charm cut for counting rather than warding.",
"LOC_SETS_SET_GILDED_BONE_CHARM_DISPLAY_NAME": "Gilded Bone Charm",
"LOC_SETS_SET_GILDED_BONE_HELM_DESCRIPTION": "A bone helm plated in gold leaf; the wearer answers slowly and completely.",
"LOC_SETS_SET_GILDED_BONE_HELM_DISPLAY_NAME": "Gilded Bone Helm",
"LOC_SETS_SET_GILDED_BONE_RELIC_DESCRIPTION": "A relic that files a claim against the next tribulation record.",
"LOC_SETS_SET_GILDED_BONE_RELIC_DISPLAY_NAME": "Gilded Bone Relic",
"LOC_SETS_SET_IRONHIDE_VIGIL_BAND_DESCRIPTION": "Quarry-iron wristband stamped with a warden sigil; steadies the hand.",
"LOC_SETS_SET_IRONHIDE_VIGIL_BAND_DISPLAY_NAME": "Ironhide Vigil Band",
"LOC_SETS_SET_IRONHIDE_VIGIL_GREATBLADE_DESCRIPTION": "Quarry blade kept blunt-edged; the weight is the weapon, not the edge.",
"LOC_SETS_SET_IRONHIDE_VIGIL_GREATBLADE_DISPLAY_NAME": "Ironhide Vigil Greatblade",
"LOC_SETS_SET_IRONHIDE_VIGIL_LENS_DESCRIPTION": "Ground quartz lens that reads an incoming technique before it lands.",
"LOC_SETS_SET_IRONHIDE_VIGIL_LENS_DISPLAY_NAME": "Ironhide Vigil Lens",
"LOC_SETS_SET_IRONHIDE_VIGIL_WARDPLATE_DESCRIPTION": "Layered hide plate that distributes a body blow across the frame.",
"LOC_SETS_SET_IRONHIDE_VIGIL_WARDPLATE_DISPLAY_NAME": "Ironhide Vigil Wardplate",
"LOC_SETS_SET_STORMCALL_CIRCUIT_BELL_DESCRIPTION": "A struck-spirit bell; each ring stores a measure of ambient qi.",
"LOC_SETS_SET_STORMCALL_CIRCUIT_BELL_DISPLAY_NAME": "Stormcall Bell",
"LOC_SETS_SET_STORMCALL_CIRCUIT_MANTLE_DESCRIPTION": "A condensation mantle that sheds charge into the wearer's meridian run.",
"LOC_SETS_SET_STORMCALL_CIRCUIT_MANTLE_DISPLAY_NAME": "Stormcall Mantle",
"LOC_SETS_SET_STORMCALL_CIRCUIT_ROD_DESCRIPTION": "A severing-edge rod that keeps a partial discharge in the circuit.",
"LOC_SETS_SET_STORMCALL_CIRCUIT_ROD_DISPLAY_NAME": "Stormcall Rod",
"LOC_SETS_SET_STORMCALL_CIRCUIT_STAFF_DESCRIPTION": "A manifestation staff tuned to a single repeatable stroke.",
"LOC_SETS_SET_STORMCALL_CIRCUIT_STAFF_DISPLAY_NAME": "Stormcall Staff",
"LOC_SETS_SET_VOID_COIL_ANCHOR_DESCRIPTION": "An anchor that fixes the coil's shape while the wearer is still.",
"LOC_SETS_SET_VOID_COIL_ANCHOR_DISPLAY_NAME": "Void Coil Anchor",
"LOC_SETS_SET_VOID_COIL_FANG_DESCRIPTION": "A serpent fang that opens and closes along the coil's own rhythm.",
"LOC_SETS_SET_VOID_COIL_FANG_DISPLAY_NAME": "Void Coil Fang",
"LOC_SETS_SET_VOID_COIL_HIDES_DESCRIPTION": "Serpent hides kept under tension; the coil tightens as the wearer moves.",
"LOC_SETS_SET_VOID_COIL_HIDES_DISPLAY_NAME": "Void Coil Hides",
"LOC_SETS_SET_VOID_COIL_RING_DESCRIPTION": "A ring that draws ambient qi into the coil instead of dispersing it.",
"LOC_SETS_SET_VOID_COIL_RING_DISPLAY_NAME": "Void Coil Ring",
"LOC_SETS_SET_VOID_COIL_SIGIL_DESCRIPTION": "A coiled sigil engraved on a single sliver of void iron.",
"LOC_SETS_SET_VOID_COIL_SIGIL_DISPLAY_NAME": "Void Coil Sigil",
"LOC_SETS_STORMCALL_CIRCUIT_DESCRIPTION": "A spirit-band circuit that stores one discharge and routes it. Two members close the circuit; five conduct it.",
"LOC_SETS_STORMCALL_CIRCUIT_DISPLAY_NAME": "Stormcall Circuit",
"LOC_SETS_UNIQUE_GILDED_BONE_PACT_LEDGER_DESCRIPTION": "A bone ledger with one entry per pact kept. Locks a fixed breakthrough-record signature; entries are settled only while the pact holds.",
"LOC_SETS_UNIQUE_GILDED_BONE_PACT_LEDGER_DISPLAY_NAME": "Ledger of the Gilded Bone Pact",
"LOC_SETS_UNIQUE_IRONHIDE_HEARTHGUARD_DESCRIPTION": "A warden's hearthstone, banked to a still body. Locks a fixed body-tempering signature; the ward survives the wearer.",
"LOC_SETS_UNIQUE_IRONHIDE_HEARTHGUARD_DISPLAY_NAME": "Hearthguard of the Ironhide Vigil",
"LOC_SETS_UNIQUE_LANTERN_OF_THE_LAST_WARD_DESCRIPTION": "A ward-lantern carried from the last defended gate. Locks a fixed transcendent signature; the light does not leave the wearer.",
"LOC_SETS_UNIQUE_LANTERN_OF_THE_LAST_WARD_DISPLAY_NAME": "Lantern of the Last Ward",
"LOC_SETS_UNIQUE_STORMCALL_THUNDER_SEAL_DESCRIPTION": "A pressed seal carrying one stored discharge. Locks a fixed spiritual-cut signature; the seal discharges through the wearer, not beside them.",
"LOC_SETS_UNIQUE_STORMCALL_THUNDER_SEAL_DISPLAY_NAME": "Thunder Seal of the Stormcall Circuit",
"LOC_SETS_UNIQUE_VOID_COIL_COILED_HEART_DESCRIPTION": "A serpent heart kept wound around a void-iron core. Locks a fixed physical-cutting signature; the heart contracts once per completed coil.",
"LOC_SETS_UNIQUE_VOID_COIL_COILED_HEART_DISPLAY_NAME": "Coiled Heart of the Void Serpent",
"LOC_SETS_VOID_SERPENT_COIL_DESCRIPTION": "An immortal-band coil wound from void iron. The set's cutting bonus belongs to the coil, so unwinding one member never removes it. Six members are authored but a body has five places to wear them: the two weapon members compete for one, so five is a full set.",
"LOC_SETS_VOID_SERPENT_COIL_DISPLAY_NAME": "Void Serpent Coil",
}
