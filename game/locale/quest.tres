[gd_resource type="Translation" format=3]

[resource]
locale = "en"
messages = {
"LOC_QUEST_THE_ACCOUNT_LEFT_OPEN_DESCRIPTION": "The clan did not settle the balance against you. It settled it against the line, which is a larger target and does not get tired. A house that owes you something it cannot repay writes your name into its own register instead, and the register is where a quarrel stops being personal. You are in the book now, and a book does not expire.",
"LOC_QUEST_THE_ACCOUNT_LEFT_OPEN_DISPLAY_NAME_1": "See your name entered in a register the house opened",
"LOC_QUEST_THE_ACCOUNT_LEFT_OPEN_DISPLAY_NAME_2": "The Account You Left Open",
"LOC_QUEST_THE_CHANNEL_CLOSED_DESCRIPTION": "A lineage passes a channel down by opening one for its successor and carrying it until the handover. You were not the successor, and the register does not show why you were given it. You carried it anyway, discharged the term under somebody else's name, and closed the office that ran on it. What taught you the technique is no longer in a position to teach it, because the technique now lives in one body and that body is yours.",
"LOC_QUEST_THE_CHANNEL_CLOSED_DISPLAY_NAME_1": "Carry the term you were handed instead of the one you were owed",
"LOC_QUEST_THE_CHANNEL_CLOSED_DISPLAY_NAME_2": "Sit the post that was opened for somebody else, and close it",
"LOC_QUEST_THE_CHANNEL_CLOSED_DISPLAY_NAME_3": "The Channel You Closed",
"LOC_QUEST_THE_RETURNED_INSTRUMENT_DESCRIPTION": "The sect only explains itself to someone who has already come back. Until you hold The One Who Returned, this page is not written for you and asking for it earns you nothing but a closed door. Having come back, the one thing still owed is a term of service, and the sect keeps a book of who served it.",
"LOC_QUEST_THE_RETURNED_INSTRUMENT_DISPLAY_NAME_1": "Serve one full term under the mountain that is waiting for you",
"LOC_QUEST_THE_RETURNED_INSTRUMENT_DISPLAY_NAME_2": "The Returned Instrument",
"LOC_QUEST_THE_SAME_QUARTER_HOUR_DESCRIPTION": "A term was sworn in front of you and broken in front of you, and both happened inside one quarter hour. The sect keeps the second entry and no file on the first, which is not the same as saying it did not see the first. Nobody asked you to be in the room. You were in the room.",
"LOC_QUEST_THE_SAME_QUARTER_HOUR_DISPLAY_NAME_1": "Stand where a sworn term is brought to zero",
"LOC_QUEST_THE_SAME_QUARTER_HOUR_DISPLAY_NAME_2": "Still be standing there when the second one clears",
"LOC_QUEST_THE_SAME_QUARTER_HOUR_DISPLAY_NAME_3": "The Same Quarter Hour",
"LOC_QUEST_THE_SEVERED_CALLING_DESCRIPTION": "The office and the register are two separate ledgers in the world, and this quest opens only where BOTH have already been written. Neither alone is enough — the sect does not write your name into a house that has not first seen you hold something.",
"LOC_QUEST_THE_SEVERED_CALLING_DISPLAY_NAME_1": "Hold the office whose work you already severed",
"LOC_QUEST_THE_SEVERED_CALLING_DISPLAY_NAME_2": "Answer to a name written into a register that binds",
"LOC_QUEST_THE_SEVERED_CALLING_DISPLAY_NAME_3": "The Severed Calling",
"LOC_QUEST_THE_SHORT_ROAD_DESCRIPTION": "An Emberbody refines faster than anything else on this mountain and dies before the ledger admits it. The sect keeps a book of bodies that burned out on schedule; this is what it wants written at the end of one — and the only line anybody can write in that book is a term of service brought to zero.",
"LOC_QUEST_THE_SHORT_ROAD_DISPLAY_NAME_1": "Burn one sworn term out on the mountain that is waiting for you",
"LOC_QUEST_THE_SHORT_ROAD_DISPLAY_NAME_2": "The Short Road",
"LOC_QUEST_THE_STATION_YOU_HELD_DESCRIPTION": "No clerk asked you to stay and no clerk wrote down that you did. The register shows a blank where a rotation should read, and the blank is the record. Pay the sect's arrears from what the pass cost you.",
"LOC_QUEST_THE_STATION_YOU_HELD_DISPLAY_NAME_1": "Stand a full rotation on the pass",
"LOC_QUEST_THE_STATION_YOU_HELD_DISPLAY_NAME_2": "Discharge three sworn terms in full",
"LOC_QUEST_THE_STATION_YOU_HELD_DISPLAY_NAME_3": "See your name entered in the household register",
"LOC_QUEST_THE_STATION_YOU_HELD_DISPLAY_NAME_4": "The Station You Held",
"LOC_QUEST_THE_TALLY_OF_A_MAN_WHO_KEPT_COUNT_DESCRIPTION": "The sect's rotation clerk kept a book of every duel decided on the pass, and the book has a column for the ones that ended without a killing blow. A name in that column is not a victory and not a defeat; it is the only entry the clerk could not file under either, and clerks do not forget a line they cannot classify. Nobody assigned you this. The book has three decided duels in your hand and two opponents still standing, and it is waiting to see whether the two cancel.",
"LOC_QUEST_THE_TALLY_OF_A_MAN_WHO_KEPT_COUNT_DISPLAY_NAME_1": "Let two of them walk, and be the one both of them can name",
"LOC_QUEST_THE_TALLY_OF_A_MAN_WHO_KEPT_COUNT_DISPLAY_NAME_2": "The Tally of a Man Who Kept Count",
"LOC_QUEST_THE_TERMS_YOU_DRAFTED_DESCRIPTION": "The order's clerks remain and you remain, because the room where you swore it is a room whose furniture outlives everyone who sat in it. You did not decide anything since. You are complying with a version of yourself written down on a day when you could not have known what it would cost. This is not an order you joined. It is an order that was written around you while you were in it.",
"LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_1": "Write the terms of an office whose end date is not yours",
"LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_2": "Stand with three named witnesses while three terms clear",
"LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_3": "Watch the register write down a successor instead of a signature",
"LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_4": "The Terms You Drafted",
"LOC_QUEST_WHAT_THE_ROTATION_COST_DESCRIPTION": "Nobody authored this. A body that stood the rotation, walked off it by its own hand, and let a third man live has crossed three unrelated ledgers at once, and the world has now written the consequence down. It ends whether you intended it to or not.",
"LOC_QUEST_WHAT_THE_ROTATION_COST_DISPLAY_NAME_1": "Stand the rotation and then put the post down yourself",
"LOC_QUEST_WHAT_THE_ROTATION_COST_DISPLAY_NAME_2": "Win three duels the sect counted",
"LOC_QUEST_WHAT_THE_ROTATION_COST_DISPLAY_NAME_3": "Let the third man walk",
"LOC_QUEST_WHAT_THE_ROTATION_COST_DISPLAY_NAME_4": "What the Rotation Cost",
}
