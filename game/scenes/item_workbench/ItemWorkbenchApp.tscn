[gd_scene load_steps=4 format=3]

; Playable entry point and the game's only composition root. The shell is a
; navigation bar over a screen stack; every screen itself comes from the route table
; in `res://src/app/screen_routes.gd`, so this scene composes navigation and nothing
; else (ADR 0002, 0027, 0033).
;
; The stack owns which screen is live and where focus goes. The nav bar stays live
; beside it, so every route is one button press or one digit away from anywhere.

[ext_resource type="Script" path="res://src/app/item_workbench_app.gd" id="1"]
[ext_resource type="Theme" path="res://src/ui/theme/chaos_world_theme.tres" id="2"]
[ext_resource type="PackedScene" path="res://scenes/nav/nav_bar.tscn" id="3"]
[ext_resource type="PackedScene" path="res://src/ui/screens/screen_stack.tscn" id="4"]

[node name="ItemWorkbenchApp" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Layout"]
layout_mode = 2

[node name="NavBar" parent="Layout/Column" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2

[node name="ScreenStack" parent="Layout/Column" instance=ExtResource("4")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
