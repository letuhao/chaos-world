[gd_resource type="Resource" script_class="DestinyDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/destiny/destiny_def.gd" id="1_destiny"]

[resource]
script = ExtResource("1_destiny")
group = &"origin"
id = &"the_one_who_returned"
display_name = "The One Who Returned"
description = "Walked into a place the register does not admit and came back out with a working method and no account of how long the absence lasted."
bearing = "Everything you now know arrived with you. Nobody else came back to compare notes, so there is no way to check."
tier = 2
visibility = &"revealed"
grants_fates = Array[StringName]([&"remembered_by_the_mountain", &"bound_name_called_once"])
gate_aliases = Array[StringName]([&"the_returned"])