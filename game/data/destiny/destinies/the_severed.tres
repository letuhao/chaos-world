[ext_resource type="Script" path="res://src/modules/destiny/destiny_def.gd" id="1_destiny"]

[resource]
script = ExtResource("1_destiny")
id = &"the_severed"
display_name = "The Severed"
description = "Carried a channel that was not yours to close, and closed it. The lineage that taught you the technique is no longer able to teach it."
bearing = "You are the last copy of a method whose authors are gone, and the method is only in you."
tier = 2
visibility = &"hidden"
teaser = "There is a gap in the lineage chart where a name should be. The chart does not say whose name."
