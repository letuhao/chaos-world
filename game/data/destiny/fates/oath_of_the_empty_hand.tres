[ext_resource type="Script" path="res://src/modules/destiny/fate_def.gd" id="1_fate"]

[resource]
script = ExtResource("1_fate")
id = &"oath_of_the_empty_hand"
display_name = "Oath of the Empty Hand"
description = "Sworn on a blade turned flat-side up, before witnesses, to strike nothing that has asked for mercy. The oath does not check whether the world agrees."
category = &"oath"
tier = 1
visibility = &"revealed"
flat_modifiers = {"defense_physical": 5.0, "poise": 8.0}
counters = Array[StringName]([&"oaths_sworn"])
tags = Array[StringName]([&"mercy", &"oath"])
difficulty_events = [{"event_type": &"combat_difficulty", "magnitude": 0.25, "description": "The oath is tested; those who fight you fight harder."}]