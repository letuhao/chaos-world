[ext_resource type="Script" path="res://src/modules/destiny/fate_def.gd" id="1_fate"]

[resource]
script = ExtResource("1_fate")
id = &"bound_name_called_once"
display_name = "The Name Spoken Once"
description = "Bound another's cultivation to your own, and that person died before the term expired. The binding resolved as written, which the sect regards as the least remarkable possible outcome."
category = &"severance"
tier = 2
visibility = &"hidden"
teaser = "One line in the ledger names two people. The second line is the sect's."
counters = Array[StringName]([&"severances"])