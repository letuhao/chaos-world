[ext_resource type="Script" path="res://src/modules/set_bonus/set_def.gd" id="1_set"]

[resource]
script = ExtResource("1_set")
id = &"ironhide_vigil"
display_name = "Ironhide Vigil"
description = "A mortal-band vigil kit. Two members hold the line, five hold the gate; the body-tempering signature is the set's own, not a member's."
