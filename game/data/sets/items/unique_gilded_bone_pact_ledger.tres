	{"option_id": &"core_breakthrough_chance", "value": 0.05},
	{"option_id": &"core_insight_gain", "value": 0.05},
	{"option_id": &"core_dao_heart", "value": 30.0},
])
roll_spec = {"count": 4, "contexts": ["prefix", "postfix"]}
