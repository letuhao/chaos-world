[resource]
script = ExtResource("1_item")
id = &"unique_gilded_bone_pact_ledger"
display_name = "Ledger of the Gilded Bone Pact"
category = &"equipment"
subcategory = &"accessory"
grade = &"immortal"
stackable = false
tags = Array[StringName]([&"unique", &"unique_route:d3_prism_guardian", &"set:gilded_bone_pact"])
