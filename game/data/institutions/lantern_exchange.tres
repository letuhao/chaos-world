[gd_resource type="Resource" script_class="InstitutionDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/core/institution_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/core/institution_position_def.gd" id="2_position"]

[sub_resource type="Resource" id="position_clerk"]
script = ExtResource("2_position")
id = &"clerk"
display_name = "LOC_INSTITUTIONS_CLERK_DISPLAY_NAME_1"
description = "LOC_INSTITUTIONS_CLERK_DESCRIPTION_1"
capacity = 0
duties = Array[StringName]([&"carry_the_seal", &"attend_the_roll"])
authorities = Array[StringName]([&"use_the_commons"])
duty_per_period = 1
patronage_per_period = 0
standing_percent_stats = {"fortune": 0.0, "loot_bonus": 0.0}

[sub_resource type="Resource" id="position_factor"]
script = ExtResource("2_position")
id = &"factor"
display_name = "LOC_INSTITUTIONS_CLERK_DISPLAY_NAME_2"
description = "LOC_INSTITUTIONS_CLERK_DESCRIPTION_2"
capacity = 5
duties = Array[StringName]([&"price_a_lot", &"settle_a_credit"])
authorities = Array[StringName]([&"extend_credit", &"call_a_lot"])
duty_per_period = 2
patronage_per_period = 2
standing_percent_stats = {"comprehension": 0.0, "insight_gain": 0.0}

[sub_resource type="Resource" id="position_first_ledger"]
script = ExtResource("2_position")
id = &"first_ledger"
display_name = "LOC_INSTITUTIONS_CLERK_DISPLAY_NAME_3"
description = "LOC_INSTITUTIONS_CLERK_DESCRIPTION_3"
capacity = 1
duties = Array[StringName]([&"weigh_the_ledger", &"call_the_settlement"])
authorities = Array[StringName]([&"name_a_factor", &"freeze_a_credit", &"expel"])
duty_per_period = 3
patronage_per_period = 3
standing_percent_stats = {"poise": 0.0, "dao_heart": 0.0}

[resource]
script = ExtResource("1_def")
kind = &"trading_guild"
capabilities = Array[StringName]([&"has_offices"])
id = &"lantern_exchange"
display_name = "LOC_INSTITUTIONS_CLERK_DISPLAY_NAME_4"
description = "LOC_INSTITUTIONS_CLERK_DESCRIPTION_4"
positions = Array[InstitutionPositionDef]([SubResource("position_clerk"), SubResource("position_factor"), SubResource("position_first_ledger")])
top_position_id = &"first_ledger"
standing_cap = 150
founder_standing = 40
founding_cost = 2400
member_duty_per_period = 1
tags = Array[StringName]([&"trade", &"credit", &"mortal_plains"])
