[resource]
script = ExtResource("1_def")
npc_id = &"courting_elder_bo"
display_name = "LOC_NPC_COURTING_ELDER_BO_DISPLAY_NAME_4"
inhabitant_id = &"azure_disciple"
tier = &"major"
faction = &"qi_dao"
tags = Array[StringName]([&"courts", &"house", &"observant"])
