base = {"physique": 15.0, "spirit": 12.0, "aptitude": 13.0, "comprehension": 15.0, "will": 16.0}
stages = Array[NpcStageDef]([SubResource("Stage_sighting"), SubResource("Stage_declared"), SubResource("Stage_answered")])
initial_stage = &"kept_at_a_distance"
daily_round = Array[NpcRoundDef]([SubResource("Round_sparring"), SubResource("Round_terrace"), SubResource("Round_gate")])
tells = Array[NpcTellDef]([SubResource("Tell_stranger"), SubResource("Tell_acquaintance"), SubResource("Tell_sworn")])
recalls = Array[NpcRecallDef]([SubResource("Recall_kin")])
round_slot_ratio_periods = 6
minor_power_scale = 0.0