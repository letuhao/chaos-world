[gd_resource type="Resource" script_class="NpcPlaceVoice" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/modules/npc/npc_place_voice.gd" id="1_voice"]
[ext_resource type="Script" path="res://src/modules/npc/npc_opinion_def.gd" id="2_opinion"]
[ext_resource type="Script" path="res://src/modules/npc/npc_tell_def.gd" id="3_tell"]

; ## What ONE PLACE sounds like (ADR 0253).
;
; ## This is the file that makes "composed on interaction" worth anything: a minor npc
; ## standing at the Qi Dao gate inherits a name, a manner AND a belief that is TRUE OF THIS
; ## ROOM, because the room authored them. One file per PLACE — not one per npc — so the
; ## content cost is proportional to the world and not to the cast.
;
; ## The opinion a minor holds about the sect that runs the gate. Narrowed to the
; ## untracked tiers, so a composed drifter has a plausible view and a composed gatekeeper
; ## does not: **the tier question is answered by the author, not by a branch in a
; ## mechanism** (ADR 0067).
[sub_resource type="Resource" id="Opinion_sect"]
script = ExtResource("2_opinion")
subject_id = &"qi_dao"
stance = &"distrust"
prose = "LOC_NPC_QI_DAO_PROSE"
opinion_seed = 0
plausible_tiers = Array[String](["minor"])

; ## The body a minor at this gate wears. Authored for the untracked tiers, for the same
; ## reason: a gatekeeper's body on approach is a DIFFERENT authored body, and it belongs
; ## to the cast member who has one rather than to a place.
[sub_resource type="Resource" id="Tell_gate"]
script = ExtResource("3_tell")
trigger = &"new_face"
matches = &""
verb = &"looks_at_your_hands"
body = "LOC_NPC_QI_DAO_BODY"
consequence = &"watches"
priority = 0
plausible_tiers = Array[String](["minor"])

[resource]
script = ExtResource("1_voice")
location_id = &"qi_dao"
names = Array[String](["LOC_NPC_QI_DAO_NAMES_1", "LOC_NPC_QI_DAO_NAMES_2", "LOC_NPC_QI_DAO_NAMES_3", "LOC_NPC_QI_DAO_NAMES_4"])
manners = Array[String](["LOC_NPC_QI_DAO_MANNERS_1", "LOC_NPC_QI_DAO_MANNERS_2", "LOC_NPC_QI_DAO_MANNERS_3", "LOC_NPC_QI_DAO_MANNERS_4"])
activities = Array[String](["LOC_NPC_QI_DAO_ACTIVITIES_1", "LOC_NPC_QI_DAO_ACTIVITIES_2", "LOC_NPC_QI_DAO_ACTIVITIES_3", "LOC_NPC_QI_DAO_ACTIVITIES_4"])
opinions = Array[NpcOpinionDef]([SubResource("Opinion_sect")])
tells = Array[NpcTellDef]([SubResource("Tell_gate")])
power_scale = 18.0