[gd_resource type="Resource" script_class="ClanDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/clan/clan_def.gd" id="1_clan"]

[resource]
script = ExtResource("1_clan")
id = &"quiethouse"
display_name = "The Quiet House"
description = "A lineage that has spent four generations buying its way out of the ledger. It publishes teaching — technique, attendance, and a chamber to practise in — and takes discretion in return: what is done inside the house is not written down and not repeated. It rivals the Saltledger over who may keep a record, because a house that files everything is a house that cannot be left alone. Admission is measured in the founder's line rather than in the member's purse, which is why it turns members away who could easily afford the fee."
founding_bloodline = &"voidborn"
ranks = Array[StringName]([&"outer", &"inner", &"core", &"heir", &"head"])
standing_bands = Array[int]([0, 25, 60, 100, 160])
patronage = {"instruction": "Technique taught by name, by a teacher the house assigns.", "quiet_chamber": "A practice chamber held in the member's name, off the public register.", "clean_record": "The house keeps no register of its members, and says so under oath."}
duty = {"secrecy": "What is taught in the house is not written down and not repeated.", "no_office": "Hold no public office while you hold an inner position or above.", "sanction": "A member who speaks outside the house answers to the house, not to a court."}
rival_clans = Array[StringName]([&"ironpact"])
tags = Array[StringName]([&"scholarly", &"lineage"])
min_purity = 0.62
required_race = &""
min_realm = 0