[resource]
script = ExtResource("1_boss")
id = &"qi_qi_refining_warden"
display_name = "Qi Refining Warden"
domain_id = &"qi_qi_refining_trial"
## The consumable guardian (ADR 0130): the ONE item that lets a death cost the bag
## instead of the soul. Declared in `loot_qi_qi_refining_warden` and the pools it
## draws, which the encounter binds by name. `BossDef.loot` is NOT also a
## declaration: it is the LEGACY projection, and a boss carrying both leaves two
## authorities answering what it drops, which `acquisition validate` rejects.
