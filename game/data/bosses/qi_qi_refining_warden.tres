[gd_resource type="Resource" script_class="BossDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/world/boss_def.gd" id="1_boss"]

[resource]
script = ExtResource("1_boss")
id = &"qi_qi_refining_warden"
display_name = "Qi Refining Warden"
domain_id = &"qi_qi_refining_trial"
## The consumable guardian (ADR 0130): the ONE item that lets a death cost the bag instead
## of the soul. Boss drops are declared in exactly one place - `BossDef.loot` - or in an
## authored loot TIER, and no tiers directory exists in this repo, so this array IS the
## declaration. Adding the item to a `pool_qi_refining` sub-table instead changed nothing a
## player can reach: the encounter pays this boss the table id `loot_qi_qi_refining_warden`
## and the pool tables are resolved by the draw, not by the encounter.
loot = Array[StringName]([&"guardian_vigil_ash"])
