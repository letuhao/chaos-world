[gd_resource type="Resource" script_class="BossDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/world/boss_def.gd" id="1_boss"]

[resource]
script = ExtResource("1_boss")
id = &"d2_gale_guardian"
display_name = "Gale Guardian Lesser"
domain_id = &"elemental_immortal_domain"
loot = Array[StringName]([])
## The wind carries every burn and every bleed already on you further than any of them
## would have run alone — which is `wind_spread.tres` in as many words, and the second
## of the two amplifiers that made the whole amplifier channel inert in production.
affliction = &"wind_spread"
