[ext_resource type="Script" path="res://src/modules/world/boss_def.gd" id="1_boss"]

[resource]
script = ExtResource("1_boss")
id = &"d6_iron_sage"
display_name = "Iron Sage"
domain_id = &"treasure_iron_sage_domain"
loot = Array[StringName]([])
; Blade-work finds the seams: the body's physical guard and its footing are cut away.
; The metal pair's sunder half — `metal_sever`, the bleed, is what the player's own blow
; inflicts, so this creature opens the guard rather than the wound.
affliction = &"metal_sunder"
