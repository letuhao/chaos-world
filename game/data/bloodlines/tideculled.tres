[gd_resource type="Resource" script_class="BloodlineDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/bloodline/bloodline_def.gd" id="1_bloodline"]

[resource]
script = ExtResource("1_bloodline")
id = &"tideculled"
display_name = "Tideculled"
description = "A line maintained by a clan that culled its own branches rather than marrying out of them. The concentration survives because the gene pool was narrowed, not improved, and it crosses races freely — the cull was a political act, never an anatomical one. Its grant favours sustained effort over sudden effort: regen and cultivation pace, nothing that spikes."
awaken_threshold = 0.42
percent_modifiers = {"qi_regen": 0.08, "cultivation_rate": 0.05}
traits = Array[StringName]([&"patient_accumulation"])
tags = Array[StringName]([&"common", &"culled", &"cross_race"])
race_id = &""