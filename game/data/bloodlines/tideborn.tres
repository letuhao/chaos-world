[gd_resource type="Resource" script_class="BloodlineDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/bloodline/bloodline_def.gd" id="1_bloodline"]

[resource]
script = ExtResource("1_bloodline")
id = &"tideborn"
display_name = "Tideborn"
description = "The oldest recorded carrier line, kept in one household so long that the name stopped describing a family and started describing a body. Two generations of pure pairing is the most this line has ever held, and the bar is set where it is because that is exactly the ceiling of an unbroken chain. Its grant trades immediate impact for sustained pressure: nothing here lands harder, everything here lasts."
awaken_threshold = 0.55
percent_modifiers = {"qi_absorption": 0.08, "status_resistance": 0.06}
traits = Array[StringName]([&"sustained_pressure"])
tags = Array[StringName]([&"rare", &"single_household"])
race_id = &"tidecaller"