[ext_resource type="Script" path="res://src/modules/bloodline/bloodline_def.gd" id="1_bloodline"]

[resource]
script = ExtResource("1_bloodline")
id = &"hearthborn"
display_name = "Hearthborn"
description = "The default concentration found in long-settled households: a lineage carried carefully for many generations, averaged with whatever else the household took in. Common as a stat-block and unsurprising as a reading — most actors hold some, and most never cross its bar. Its grant is small on purpose; the line is common because it is dependable, not because it is strong."
awaken_threshold = 0.42
percent_modifiers = {"max_health": 0.05, "qi_regen": 0.03}
traits = Array[StringName]([&"steady_constitution"])
tags = Array[StringName]([&"common", &"settled"])
race_id = &""