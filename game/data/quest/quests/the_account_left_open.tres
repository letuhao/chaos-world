[resource]
script = ExtResource("1_quest")
id = &"the_account_left_open"
display_name = "LOC_QUEST_THE_ACCOUNT_LEFT_OPEN_DISPLAY_NAME_2"
description = "LOC_QUEST_THE_ACCOUNT_LEFT_OPEN_DESCRIPTION"
kind = &"authored"
tier = 1
requirement = {}
steps = Array[ExtResource("2_step")]([SubResource("QuestStep_account_named")])
