[gd_resource type="Resource" script_class="QuestDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/modules/quest/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://src/modules/quest/quest_step_def.gd" id="2_step"]

[sub_resource type="Resource" id="QuestStep_account_named"]
script = ExtResource("2_step")
step_id = &"account_named"
fact = &"feud_account_named_against_you"
need = 1
display_name = "Be named on an account the clan opened"

[sub_resource type="Resource" id="QuestStep_settlement_refused"]
script = ExtResource("2_step")
step_id = &"settlement_refused"
fact = &"settlement_refused_and_left"
need = 1
display_name = "Leave without settling it"

[resource]
script = ExtResource("1_quest")
id = &"the_account_left_open"
display_name = "The Account You Left Open"
description = "The clan did not settle the balance against you. It settled it against the line, which is a larger target and does not get tired. You entered a house with a quarrel already in it and you left having added to it rather than having ended it. Nobody pursued you. The balance simply stopped being yours and became the family's, and a family does not expire."
kind = &"authored"
tier = 1
requirement = {}
steps = Array[ExtResource("2_step")]([SubResource("QuestStep_account_named"), SubResource("QuestStep_settlement_refused")])
grants = Array[Dictionary]([{"kind": &"fate", "id": &"ancestral_debt_unpaid", "amount": 1}])
