[gd_resource type="Resource" script_class="QuestDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/modules/quest/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://src/modules/quest/quest_step_def.gd" id="2_step"]

[sub_resource type="Resource" id="QuestStep_terms_written"]
script = ExtResource("2_step")
step_id = &"terms_written"
fact = &"sect_post_held"
need = 1
display_name = "LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_1"

[sub_resource type="Resource" id="QuestStep_witnesses_signed"]
script = ExtResource("2_step")
step_id = &"witnesses_signed"
fact = &"oaths_discharged"
need = 3
display_name = "LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_2"

[sub_resource type="Resource" id="QuestStep_clerk_resigned"]
script = ExtResource("2_step")
step_id = &"clerk_resigned"
fact = &"household_heir_registered"
need = 1
display_name = "LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_3"

[resource]
script = ExtResource("1_quest")
id = &"the_terms_you_drafted"
display_name = "LOC_QUEST_THE_TERMS_YOU_DRAFTED_DISPLAY_NAME_4"
description = "LOC_QUEST_THE_TERMS_YOU_DRAFTED_DESCRIPTION"
kind = &"authored"
tier = 3
requirement = {"verb": &"has_destiny", "id": &"the_one_who_stayed"}
steps = Array[ExtResource("2_step")]([SubResource("QuestStep_terms_written"), SubResource("QuestStep_witnesses_signed"), SubResource("QuestStep_clerk_resigned")])
grants = Array[Dictionary]([{"kind": &"destiny", "id": &"the_oath_bound", "amount": 1}])