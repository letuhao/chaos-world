[gd_resource type="Resource" script_class="EventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/modules/event/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://src/modules/event/event_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Stage_the_petition"]
script = ExtResource("2_stage")
stage_id = &"the_petition"
display_name = "LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_1"
requires = {}
duration_periods = 1
on_enter = [{"fact": &"elder_wei_petition_heard", "amount": 1}]

[sub_resource type="Resource" id="Stage_the_favour"]
script = ExtResource("2_stage")
stage_id = &"the_favour"
display_name = "LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_2"
requires = {"verb": &"fact", "id": &"elder_wei_petition_heard", "need": 1}
duration_periods = 0
on_enter = [{"fact": &"elder_wei_favour_counted", "amount": 1}, {"fact": &"elder_wei_favours_shown", "amount": 1, "kind": &"npc_tally", "npc_id": &"elder_wei", "verb": &"favours"}]

[sub_resource type="Resource" id="Stage_the_oath"]
script = ExtResource("2_stage")
stage_id = &"the_oath"
display_name = "LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_3"
requires = {"verb": &"fact", "id": &"elder_wei_favours_shown", "need": 1}
duration_periods = 0
on_enter = [{"fact": &"elder_wei_oath_taken", "amount": 1, "kind": &"npc_tally", "npc_id": &"elder_wei", "verb": &"oaths_sworn"}]

[resource]
script = ExtResource("1_event")
id = &"the_favour_of_elder_wei"
display_name = "LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DISPLAY_NAME_4"
description = "LOC_EVENT_THE_FAVOUR_OF_ELDER_WEI_DESCRIPTION"
kind = &"disaster"
trigger = {"verb": &"fact", "id": &"storm_front_sighted", "need": 1}
location_id = &"mortal_plains"
on_enter = [{"fact": &"elder_wei_petition_opened", "amount": 1}]
stages = Array[EventStageDef]([SubResource("Stage_the_petition"), SubResource("Stage_the_favour"), SubResource("Stage_the_oath")])
pay = Array[Dictionary]([])