[gd_resource type="Resource" script_class="EventDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/modules/event/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://src/modules/event/event_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Stage_read"]
script = ExtResource("2_stage")
stage_id = &"read"
display_name = "It Answers, Once"
requires = {}
duration_periods = 0
on_enter = [{"fact": &"treasure_stone_read", "amount": 1}]

[resource]
script = ExtResource("1_event")
id = &"the_stone_that_answering"
display_name = "The Stone That Answering"
description = "A dao fragment that answers when it is read, once, and then stops. One stage, because one reading is the whole event: `EventApi.begin` refuses an event that authors no stage (`event_authors_no_stage`), so the empty ladder that used to sit here was not a minimal shape — it was an event nothing could ever open. NOT TRIGGER-GATED, and that is the ADR 0217 shape: the `none_of(fact treasure_stone_read)` gate this event used to carry demanded a fact produced only by its OWN stage 0, which fails the SATISFIABLE test because the only producer is the door the gate is attached to. It was also a gate that was already OPEN on a bare hero, which fails the NON-TRIVIAL test for the same reason — a discovery does not announce itself, and the thing standing in the transcendent realm is the discovery's own condition. The once-rule is NOT lost with the gate: `EventApi.begin` and `EventApi.available` both refuse a resolved event (`already_resolved`), so the ledger owns 'read once' where it already did."
kind = &"rare_treasure"
trigger = {}
location_id = &"transcendent_realm"
on_enter = [{"fact": &"treasure_stone_found", "amount": 1}]
stages = Array[EventStageDef]([SubResource("Stage_read")])
pay = Array[Dictionary]([{"kind": &"fate", "id": &"heaven_s_warning_unread", "amount": 1}, {"kind": &"nation_standing", "id": &"march_of_the_nine_provinces", "amount": 4}])