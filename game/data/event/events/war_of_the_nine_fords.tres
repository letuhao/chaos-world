[gd_resource type="Resource" script_class="EventDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/modules/event/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://src/modules/event/event_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Stage_levies_called"]
script = ExtResource("2_stage")
stage_id = &"levies_called"
display_name = "LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_1"
requires = {}
duration_periods = 2
on_enter = [{"fact": &"sect_war_levied", "amount": 1}, {"fact": &"sect_war_begun", "amount": 1}]

[sub_resource type="Resource" id="Stage_fords_held"]
script = ExtResource("2_stage")
stage_id = &"fords_held"
display_name = "LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_2"
requires = {"verb": &"fact", "id": &"sect_war_begun", "need": 1}
duration_periods = 3
on_enter = [{"fact": &"sect_war_contested", "amount": 1}]

[sub_resource type="Resource" id="Stage_verdict_read"]
script = ExtResource("2_stage")
stage_id = &"verdict_read"
display_name = "LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_3"
requires = {"verb": &"fact", "id": &"sect_war_contested", "need": 1}
duration_periods = 0
on_enter = [{"fact": &"sect_war_decided", "amount": 1}]

[resource]
script = ExtResource("1_event")
id = &"war_of_the_nine_fords"
display_name = "LOC_EVENT_WAR_OF_THE_NINE_FORDS_DISPLAY_NAME_4"
description = "LOC_EVENT_WAR_OF_THE_NINE_FORDS_DESCRIPTION"
kind = &"sect_war"
trigger = {"verb": &"all_of", "of": [{"verb": &"fact", "id": &"sect_war_called", "need": 1}, {"verb": &"declare", "other_id": &"court_of_the_star", "territory_id": &"river_march", "mode": &"siege", "transfer": &"ownership", "standing": {"march_of_the_nine_provinces": 12, "court_of_the_star": -12}}]}
location_id = &"mortal_plains"
on_enter = [{"fact": &"sect_war_declared", "amount": 1}]
stages = Array[EventStageDef]([SubResource("Stage_levies_called"), SubResource("Stage_fords_held"), SubResource("Stage_verdict_read")])
pay = Array[Dictionary]([{"kind": &"fate", "id": &"oath_kept_under_witness", "amount": 1}, {"kind": &"nation_standing", "id": &"court_of_the_star", "amount": 12}])