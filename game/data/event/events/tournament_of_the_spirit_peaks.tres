[gd_resource type="Resource" script_class="EventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/modules/event/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://src/modules/event/event_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Stage_registered"]
script = ExtResource("2_stage")
stage_id = &"registered"
display_name = "LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_1"
requires = {}
duration_periods = 1
on_enter = [{"fact": &"tournament_registered", "amount": 1}]

[sub_resource type="Resource" id="Stage_first_round"]
script = ExtResource("2_stage")
stage_id = &"first_round"
display_name = "LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_2"
requires = {"verb": &"fact", "id": &"tournament_registered", "need": 1}
duration_periods = 1
on_enter = [{"fact": &"tournament_rounds_fought", "amount": 1}]

[sub_resource type="Resource" id="Stage_final"]
script = ExtResource("2_stage")
stage_id = &"final"
display_name = "LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_3"
requires = {"verb": &"fact", "id": &"tournament_rounds_fought", "need": 1}
duration_periods = 1
on_enter = [{"fact": &"tournament_final_fought", "amount": 1}]
resolves = {"war_id": &"war_of_the_nine_fords", "winner_id": &"court_of_the_star"}

[resource]
script = ExtResource("1_event")
id = &"tournament_of_the_spirit_peaks"
display_name = "LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DISPLAY_NAME_4"
description = "LOC_EVENT_TOURNAMENT_OF_THE_SPIRIT_PEAKS_DESCRIPTION"
kind = &"tournament"
trigger = {"verb": &"fact", "id": &"tournament_called", "need": 1}
location_id = &"spirit_peaks"
on_enter = []
stages = Array[EventStageDef]([SubResource("Stage_registered"), SubResource("Stage_first_round"), SubResource("Stage_final")])
pay = Array[Dictionary]([{"kind": &"fate", "id": &"first_blood_duel", "amount": 1}, {"kind": &"destiny", "id": &"the_chosen_instrument", "amount": 1}])