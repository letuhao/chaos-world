[gd_resource type="Resource" script_class="EventDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/modules/event/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://src/modules/event/event_stage_def.gd" id="2_stage"]

[sub_resource type="Resource" id="Stage_riven"]
script = ExtResource("2_stage")
stage_id = &"riven"
display_name = "LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_1"
requires = {}
duration_periods = 1
on_enter = [{"fact": &"disaster_struck", "amount": 1}]

[sub_resource type="Resource" id="Stage_holding"]
script = ExtResource("2_stage")
stage_id = &"holding"
display_name = "LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_2"
requires = {"verb": &"fact", "id": &"disaster_struck", "need": 1}
duration_periods = 2
on_enter = [{"fact": &"disaster_held", "amount": 1}]

[sub_resource type="Resource" id="Stage_aftermath"]
script = ExtResource("2_stage")
stage_id = &"aftermath"
display_name = "LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_3"
requires = {"verb": &"fact", "id": &"disaster_held", "need": 1}
duration_periods = 0
on_enter = [{"fact": &"disaster_survived", "amount": 1}]

[resource]
script = ExtResource("1_event")
id = &"the_riven_peak_disaster"
display_name = "LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DISPLAY_NAME_4"
description = "LOC_EVENT_THE_RIVEN_PEAK_DISASTER_DESCRIPTION"
kind = &"disaster"
trigger = {"verb": &"fact", "id": &"storm_front_sighted", "need": 1}
location_id = &"spirit_peaks"
on_enter = [{"fact": &"disaster_begun", "amount": 1}]
stages = Array[EventStageDef]([SubResource("Stage_riven"), SubResource("Stage_holding"), SubResource("Stage_aftermath")])
pay = Array[Dictionary]([{"kind": &"fate", "id": &"remembered_by_the_mountain", "amount": 1}])