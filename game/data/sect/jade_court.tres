[gd_resource type="Resource" script_class="SectDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/modules/sect/sect_def.gd" id="1_sect"]
[ext_resource type="Script" path="res://src/modules/sect/sect_position_def.gd" id="2_position"]

[sub_resource type="Resource" id="position_disciple"]
script = ExtResource("2_position")
id = &"disciple"
display_name = "LOC_SECT_DISCIPLE_DISPLAY_NAME_1"
description = "LOC_SECT_DISCIPLE_DESCRIPTION_1"
standing_floor = 0
capacity = 0
duties = Array[StringName]([&"attend_instruction", &"labour_in_the_hall"])
authorities = Array[StringName]([&"use_the_common_shelf"])
succession_method = &"seniority"
succession_param = {"order": "most_standing"}
standing_percent_stats = {}
patronage_per_period = 0
duty_per_period = 1

[sub_resource type="Resource" id="position_reader"]
script = ExtResource("2_position")
id = &"reader"
display_name = "LOC_SECT_DISCIPLE_DISPLAY_NAME_2"
description = "LOC_SECT_DISCIPLE_DESCRIPTION_2"
standing_floor = 20
capacity = 4
duties = Array[StringName]([&"keep_the_ledger", &"attend_instruction"])
authorities = Array[StringName]([&"read_the_outer_shelf", &"nominate_a_disciple"])
succession_method = &"seniority"
succession_param = {"order": "most_standing"}
standing_percent_stats = {"insight_gain": 0.0, "comprehension": 0.0}
patronage_per_period = 1
duty_per_period = 1

[sub_resource type="Resource" id="position_steward"]
script = ExtResource("2_position")
id = &"steward"
display_name = "LOC_SECT_DISCIPLE_DISPLAY_NAME_3"
description = "LOC_SECT_DISCIPLE_DESCRIPTION_3"
standing_floor = 60
capacity = 1
duties = Array[StringName]([&"hold_the_seal", &"teach", &"settle_the_ledger"])
authorities = Array[StringName]([&"read_the_sealed_shelf", &"nominate_a_reader", &"expel"])
succession_method = &"trial"
succession_param = {"stage_keeper": "the_four_readers", "question": "what_the_house_will_teach_next"}
succession_periods = 1
teach_tax = 1.0
standing_percent_stats = {"insight_gain": 0.0, "qi_regen": 0.0}
patronage_per_period = 2
duty_per_period = 2

[sub_resource type="Resource" id="position_lantern"]
script = ExtResource("2_position")
id = &"lantern_keeper"
display_name = "LOC_SECT_DISCIPLE_DISPLAY_NAME_4"
description = "LOC_SECT_DISCIPLE_DESCRIPTION_4"
standing_floor = 10
capacity = 2
duties = Array[StringName]([&"keep_the_watch", &"carry_the_lantern"])
authorities = Array[StringName]([&"open_the_gate", &"turn_away_a_stranger"])
succession_method = &"named"
succession_param = {"naming_body": "the_outer_ring"}
standing_percent_stats = {"poise": 0.0, "max_stamina": 0.0}
patronage_per_period = 1
duty_per_period = 2

[resource]
script = ExtResource("1_sect")
id = &"jade_court"
display_name = "LOC_SECT_DISCIPLE_DISPLAY_NAME_5"
description = "LOC_SECT_DISCIPLE_DESCRIPTION_5"
doctrine_id = &"still_water"
top_position_id = &"steward"
positions = Array[SectPositionDef]([SubResource("position_disciple"), SubResource("position_reader"), SubResource("position_lantern"), SubResource("position_steward")])
min_purity = 0
standing_cap = 100
founding_cost = {"currency": "silver", "amount": 400, "found": 400, "outstanding": 400}