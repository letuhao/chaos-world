[gd_resource type="Resource" script_class="NationDef" load_steps=10 format=3]

[ext_resource type="Script" path="res://src/modules/nation/nation_def.gd" id="1_nation"]
[ext_resource type="Script" path="res://src/modules/nation/nation_office_def.gd" id="2_office"]
[ext_resource type="Script" path="res://src/core/institution_claim.gd" id="3_claim"]

[sub_resource type="Resource" id="office_marshal"]
script = ExtResource("2_office")
id = &"marshal"
display_name = "LOC_NATION_MARSHAL_DISPLAY_NAME_1"
description = "LOC_NATION_MARSHAL_DESCRIPTION_1"
powers = Array[StringName]([&"close_the_fords", &"call_the_levy", &"judge_the_boundary"])
capacity = 1
succession_method = &"trial"
succession_param = {"stages": ["sworn_at_the_ford", "held_the_bridge", "named_by_the_march"]}
standing_percent_stats = {"defense_physical": 0.0, "max_health": 0.0}

[sub_resource type="Resource" id="office_reeve"]
script = ExtResource("2_office")
id = &"reeve"
display_name = "LOC_NATION_MARSHAL_DISPLAY_NAME_2"
description = "LOC_NATION_MARSHAL_DESCRIPTION_2"
powers = Array[StringName]([&"assess_the_tithe", &"grant_seat_of_hearing"])
capacity = 1
succession_method = &"appointed"
succession_param = {"naming_body": "the_marshals"}
standing_percent_stats = {"max_health": 0.0, "qi_regen": 0.0}

[sub_resource type="Resource" id="office_lantern_keeper"]
script = ExtResource("2_office")
id = &"lantern_keeper"
display_name = "LOC_NATION_MARSHAL_DISPLAY_NAME_3"
description = "LOC_NATION_MARSHAL_DESCRIPTION_3"
powers = Array[StringName]([&"light_the_beacons"])
capacity = 1
succession_method = &"heir"
succession_param = {"charter": "the_march_charter"}
standing_percent_stats = {"evasion": 0.0}

[sub_resource type="Resource" id="office_auditor"]
script = ExtResource("2_office")
id = &"auditor"
display_name = "LOC_NATION_MARSHAL_DISPLAY_NAME_4"
description = "LOC_NATION_MARSHAL_DESCRIPTION_4"
powers = Array[StringName]([&"read_the_ledger", &"call_the_debt"])
capacity = 3
succession_method = &"appointed"
succession_param = {"naming_body": "the_reeve"}
standing_percent_stats = {"comprehension": 0.0, "insight_gain": 0.0}

[sub_resource type="Resource" id="office_quartermaster"]
script = ExtResource("2_office")
id = &"quartermaster"
display_name = "LOC_NATION_MARSHAL_DISPLAY_NAME_5"
description = "LOC_NATION_MARSHAL_DESCRIPTION_5"
powers = Array[StringName]([&"open_the_granary"])
capacity = 1
succession_method = &"contest"
succession_param = {"quota": 3}
standing_percent_stats = {}

[sub_resource type="Resource" id="claim_march"]
script = ExtResource("3_claim")
position = &"march"
standing = 80
standing_cap = 120
obligation = {"ford_dues": 2, "winter_grain": 1}

[resource]
script = ExtResource("1_nation")
id = &"march_of_the_nine_provinces"
display_name = "LOC_NATION_MARSHAL_DISPLAY_NAME_6"
description = "LOC_NATION_MARSHAL_DESCRIPTION_6"
offices = Array[NationOfficeDef]([SubResource("office_marshal"), SubResource("office_reeve"), SubResource("office_lantern_keeper"), SubResource("office_auditor"), SubResource("office_quartermaster")])
territory_ids = Array[StringName]([&"river_march", &"ashen_wold", &"nine_province_reach"])
sect_ids = Array[StringName]([&"iron_vine", &"jade_court"])
initial_offices = {"marshal": "mira_of_the_ford", "reeve": "", "lantern_keeper": "", "auditor": "hollis_third", "quartermaster": ""}
claim = SubResource("claim_march")
tags = Array[StringName]([&"riverine", &"warlike", &"tributary"])