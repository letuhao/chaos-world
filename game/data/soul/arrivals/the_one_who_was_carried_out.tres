[ext_resource type="Script" path="res://src/modules/soul/soul_def.gd" id="1_soul"]

[resource]
script = ExtResource("1_soul")
id = &"the_one_who_was_carried_out"
display_name = "The One Who Was Carried Out"
description = "The second return. This body does not arrive under its own power; someone else finished the journey, and the ledger records who."
bearing = "You were brought. That is a debt, and it has a name attached."
