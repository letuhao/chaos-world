[gd_resource type="Resource" script_class="StatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/status_def.gd" id="1_status"]

[resource]
script = ExtResource("1_status")
id = &"wind_stride"
element = &"wind"
kind = &"stat_modifier"
family = &"gale"
categories = Array[StringName]([&"stat_modifier"])
scope = &"cultivation"
stacking = &"refresh"
duration = -1.0
magnitude_unit = &"stat_modifier"
magnitude_cap = 1.0
tick_interval = 1.0
mitigation_tags = Array[StringName]([&"affinity", &"technique", &"pill"])
payload = {
"mechanic": &"regrowth",
"text": "LOC_STATUSES_WIND_STRIDE_TEXT",
"modifiers": [
{"stat": &"stamina_regen", "op": &"flat", "value": 2.0},
{"stat": &"move_speed", "op": &"flat", "value": 8.0}
]
}
