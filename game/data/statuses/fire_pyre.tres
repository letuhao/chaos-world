[gd_resource type="Resource" script_class="StatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/status_def.gd" id="1_status"]

[resource]
script = ExtResource("1_status")
id = &"fire_pyre"
element = &"fire"
kind = &"amplifier"
family = &"burn"
categories = Array[StringName]([&"amplifier"])
scope = &"combat"
stacking = &"refresh"
duration = 18.0
magnitude_unit = &"sibling_amp"
magnitude_cap = 1.0
tick_interval = 1.0
mitigation_tags = Array[StringName]([&"affinity", &"technique"])
; The same tag as `fire_immolation` (DEF-0352): one defence answers the whole burn family,
; which is what makes the tag a family rather than one def's private note.
immunity_tags = Array[StringName]([&"burn"])
payload = {
"mechanic": &"feed_siblings",
"text": "A burning body burns harder. Every other burn already on the target feeds this one.",
"sibling_gain": 0.5,
"sibling_cap": 0.4,
"modifiers": []
}