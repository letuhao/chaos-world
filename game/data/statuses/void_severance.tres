tick_interval = 1.0
mitigation_tags = Array[StringName]([&"affinity", &"technique", &"pill"])
payload = {
"mechanic": &"drain",
"text": "LOC_STATUSES_VOID_SEVERANCE_TEXT",
"pool": &"qi",
"share_per_pulse": 0.03,
"modifiers": [
{"stat": &"qi_regen", "op": &"flat", "value": -1.0},
{"stat": &"max_qi", "op": &"flat", "value": -20.0}
],
"counter": {"every_hits": 12, "reset_on_burst": true},
}
