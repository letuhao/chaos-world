[gd_resource type="Resource" script_class="StatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/status_def.gd" id="1_status"]

[resource]
script = ExtResource("1_status")
id = &"wood_bloom"
element = &"wood"
kind = &"amplifier"
family = &"growth"
categories = Array[StringName]([&"amplifier"])
scope = &"cultivation"
stacking = &"refresh"
duration = -1.0
magnitude_unit = &"stat_modifier"
magnitude_cap = 1.0
tick_interval = 1.0
mitigation_tags = Array[StringName]([&"affinity", &"technique", &"pill"])
payload = {
"mechanic": &"regrowth",
"text": "Verdant regrowth. The body holds more of itself and knits faster than it should.",
"modifiers": [
{"stat": &"max_health", "op": &"flat", "value": 25.0},
{"stat": &"health_regen", "op": &"flat", "value": 1.5}
]
}