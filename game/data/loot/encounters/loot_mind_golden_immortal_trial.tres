	{"boss_id": &"mind_golden_immortal_warden", "table_id": &"loot_mind_golden_immortal_warden"},
	{"boss_id": &"F13_golden_warden", "table_id": &"loot_F13_golden_warden"},
])

[sub_resource type="Resource" id="tier_1"]
script = ExtResource("2_tier")
