	{"boss_id": &"body_qi_refining_guardian", "table_id": &"loot_body_qi_refining_guardian"},
	{"boss_id": &"E1_qi_refinement_warden", "table_id": &"loot_E1_qi_refinement_warden"},
])

[resource]
