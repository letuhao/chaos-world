[gd_resource type="Resource" script_class="RaceDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/race/race_def.gd" id="1_race"]

[resource]
script = ExtResource("1_race")
id = &"emberblood_touched"
display_name = "Emberblood Touched"
description = "A frame that carries one of the three disciplines in its marrow rather than being denied it. Every specialist race here closes a path outright because its anatomy refuses the other discipline; this one closes neither, because it was altered rather than specialised, and it pays for that in reach: nothing it does is native, so it is competent everywhere and formidable nowhere. It is the only body in the pool that can walk two paths at once, which is why the origin that arrives through it has a choice the other two do not."
dominance = 0.55
manifestation_threshold = 0.12
gestation_days = 26.0
base_fertility = 0.5
base_potency = 0.6
offspring_variance = 0.25
; NOTHING is closed, and that is the whole point. ADR 0109 makes a body plan a
; structural liability rather than a bag of bonuses, and ADR 0062 forbids buying a
; path off with an item. This body still pays: it has no native faculty in any
; discipline, so its cultivation_rate is the lowest in the pool and its reach
; ceiling is the second lowest. An open body is a narrow one that has not yet
; decided, not a broad one that has been given everything — otherwise "closed
; nothing" would be the best body in the game, which is exactly what
; `commonborn`'s comment above says must not be true.
;
; It exists because three origins need three DISTINCT path sets. stoneborn and
; emberblood both close `mind_cultivation`, so mapping three origins onto three
; races produced two origins that restricted the same path — materially the same
; player choice wearing two names, which is the ADR 0065 lie this file is not.
closed_paths = Array[StringName]([])
; Ordinal 9 is Dao Ancestor, so this body can reach the last Mortal realm and no
; further: altered is not ascendant.
realm_ceiling = 9
lifespan = 30000.0
# The altered frame: an emberblood body with a longer reach than the parent it came from.
# Its starting age is the emberblood one, because that is still the body it is — ADR 0258 §2
# asks for the SPECIES' age, and the touch changed what the frame may become, not when it
# was born.
starting_age_years = 1.0
base_attributes = {"physique": 2.0, "spirit": 1.0, "aptitude": 1.0, "comprehension": 1.0, "agility": 1.0, "will": 2.0, "fortune": 1.0}
percent_modifiers = {"cultivation_rate": -0.05, "qi_regen": 0.05, "breakthrough_chance": 0.05}
affinities = {"fire": 4.0, "wood": 1.0}
tags = Array[StringName]([&"altered", &"unbound"])