script = ExtResource("1_race")
id = &"stoneborn"
display_name = "Stoneborn"
description = "A dense, slow body assembled for load-bearing work. It carries more physique and stamina than anything else here and it stops at the Immortal tier, because the density that makes it durable is the same density that will not let a dantian form. Mind cultivation is closed outright."
