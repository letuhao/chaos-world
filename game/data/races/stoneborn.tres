closed_paths = Array[StringName]([&"mind_cultivation"])
; The density that makes this body durable is the same density that will not let a
; dantian form, so it stops at ordinal 17 — Immortal Sovereign, the last of the nine
; Immortal realms. It reaches further than a commonborn's 8 for a reason no item buys:
; the ceiling is anatomy, and nobody has written the surgery that changes it.
realm_ceiling = 17
lifespan = 54000.0
# Slow to mature: the densest body in the tree carries the longest gestation (42 days) and
# a long life, so it begins later and has more of its life to spend above the first band.
# ADR 0258 §2.
starting_age_years = 4.0
base_attributes = {"physique": 4.0, "will": 1.0}
percent_modifiers = {"max_health": 0.15, "defense_physical": 0.2, "poise": 0.1, "max_qi": -0.15, "insight_gain": -0.2}
affinities = {"earth": 9.0, "metal": 4.0}
