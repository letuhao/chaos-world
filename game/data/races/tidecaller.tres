[gd_resource type="Resource" script_class="RaceDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/race/race_def.gd" id="1_race"]

[resource]
script = ExtResource("1_race")
id = &"tidecaller"
display_name = "LOC_RACES_TIDECALLER_DISPLAY_NAME"
description = "LOC_RACES_TIDECALLER_DESCRIPTION"
dominance = 0.55
manifestation_threshold = 0.2
gestation_days = 36.0
base_fertility = 0.45
base_potency = 0.45
offspring_variance = 0.15
closed_paths = Array[StringName]([&"body_cultivation"])
realm_ceiling = 0
lifespan = 58400.0
# The longest-lived body in the tree, and the one that takes longest to arrive. ADR 0258 §2.
starting_age_years = 5.0
; The attributes this body does not specialise in are the plain mortal 1.0 that
; `commonborn` writes for all seven, except where this body says otherwise below.
; Physique is AUTHORED rather than left out because an omitted grant is a grant of 0.0 —
; `_grant` only ever ADDS, since a modifier cannot lower a base — and ATTACK_PHYSICAL is
; `physique * 2.0`. Omitting it does not make this body even-framed, it makes it unable to
; hit anything. This one is close to that line, and that is the description talking: it
; closes `body_cultivation`, fights at `attack_physical * -0.2`, and can still swing.
base_attributes = {"physique": 1.0, "comprehension": 3.0, "will": 2.0, "spirit": 1.0}
percent_modifiers = {"insight_gain": 0.2, "breakthrough_chance": 0.05, "evasion": 0.15, "attack_physical": -0.2, "defense_physical": -0.1}
affinities = {"water": 10.0, "ice": 3.0}
tags = Array[StringName]([&"mind", &"long_lived", &"fragile"])
