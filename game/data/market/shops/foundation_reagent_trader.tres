[gd_resource type="Resource" script_class="ShopDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/market/shop_def.gd" id="1_shop"]

[resource]
script = ExtResource("1_shop")
shop_id = &"foundation_reagent_trader"
display_name = "LOC_MARKET_FOUNDATION_REAGENT_TRADER_DISPLAY_NAME"
kind = &"trader"
stock = Array[Dictionary]([{"def_id": &"alchemy_clarity_pill", "quantity": 6}, {"def_id": &"alchemy_vigor_elixir", "quantity": 4}, {"def_id": &"alchemy_mist_herb", "quantity": 10}])
; `buys` carries `alchemy_clarity_pill` - the very first row of this def's own `stock`. A
; reagent trader that sells a reagent but refuses to buy one is not a trader: the buy list
; was authored as the two herbs alone, so `MarketApi.sell` refused `shop_will_not_buy` the
; moment a player tried to sell back what it had just sold them. Stock is what a shop deals
; in, so every stackable good on the shelf is also a good it buys. `test_economy_content.gd`
; pins the buy lists only structurally (each id resolves, at least one shop buys nothing,
; the lists differ from one another), which this satisfies.
buys = Array[StringName]([&"alchemy_clarity_pill", &"alchemy_mist_herb", &"astral_lunar_veil_herb"])
location_id = &"foundation_reagent_row"
capacity = 12
