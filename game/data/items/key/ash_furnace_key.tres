[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"ash_furnace_key"
display_name = "Furnace Key"
category = &"key"
rarity = &"common"
realm = &"core_formation"
## `ash_furnace_hoard`'s `key_item_id`. `DomainFixtures._key_gate` measures it with
## `DomainBoot.key_reach_of`, which reads `key_reach` off the WHOLE carried
## inventory and refuses at 0.0 — so before this item existed the gate was
## unsatisfiable and the hoard was content no player could ever claim.
## Smelted from a bar and a gem, both of which any early hero already pays.
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"key_reach", "value": 3},
])
roll_spec = {"count": 1, "contexts": ["base"]}
subcategory = &"key"
grade = &"mortal"
sources = Array[StringName]([&"craft:ash_furnace_key_recipe"])