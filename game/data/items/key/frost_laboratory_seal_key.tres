[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Resource" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"frost_laboratory_seal_key"
display_name = "LOC_ITEMS_FROST_LABORATORY_SEAL_KEY_DISPLAY_NAME"
category = &"key"
rarity = &"common"
realm = &"foundation"
## `frost_lab_seal`'s reward: the formation's own key, paid when the seal's sequence
## is struck correctly (ADR 0216 §4, one realized instance). `key_reach` is the same
## measure `DomainBoot.key_reach_of` reads for every keyed hoard, so the day a frost
## gate authors `key_item_id: frost_laboratory_seal_key`, the gate is satisfiable by
## construction rather than by a second definition of "holds the key".
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"key_reach", "value": 3},
	{"option_id": &"trade_value", "value": 5},
])
roll_spec = {"count": 1, "contexts": ["base"]}
subcategory = &"key"
grade = &"mortal"
sources = Array[StringName]([&"domain:scroll_frost_serpent_domain"])
