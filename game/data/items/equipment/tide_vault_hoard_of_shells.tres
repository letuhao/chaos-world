[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"tide_vault_hoard_of_shells"
display_name = "Hoard of Vault Shells"
category = &"equipment"
rarity = &"magic"
realm = &"spirit_unity"
## `tide_vault_hoard`'s reward. The room is a drowned vault with no key and no
## realm floor (ADR 0217 both tests PASS: nothing gates it), so the PRIZE has to
## carry the value the walk does not — and ADR 0216 is explicit that a hoard holds
## ONE specific object, not a stack. The counterplay the yin-yang rule demands of
## a strong item rides in `grade`: `spirit` is tier 2, so a Foundation hero who
## loots it is carrying a piece `Equipment._meets_requirements` refuses to wear.
## That is the cost authored instead of a raw number buff.
## `accessory` because a shell-strung focus is worn, not swung; one realized
## instance, realized through `ItemsApi.generate` seeded from the fixture id.
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"core_max_health", "value": 16.0},
	{"option_id": &"element_resistance_ice", "value": 4.0},
])
roll_spec = {"count": 2, "contexts": ["prefix", "postfix"]}
subcategory = &"accessory"
stackable = false
grade = &"spirit"
sources = Array[StringName]([&"domain:marine_coral_leviathan_domain"])