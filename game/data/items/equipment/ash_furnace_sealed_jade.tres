[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"ash_furnace_sealed_jade"
display_name = "Furnace-Sealed Jade"
category = &"equipment"
rarity = &"rare"
realm = &"core_formation"
## `ash_furnace_hoard`'s reward: the SPECIFIC OBJECT the room is about (ADR 0216),
## one unit, realized through `ItemsApi.generate` seeded from the fixture id.
## An `artifact` because it is a sealed relic worn as a focus, not a weapon or an
## armour — the pile it came from is a furnace's caked heart, not a forge's rack.
## `core_formation` puts the magnitude where the realm gate opens, so the prize is
## worth reaching and the ceiling stops a Foundation hero looting it (ADR 0218
## REALM-GATED). `stackable = false` because every authored equipment piece is
## one realized instance: a "2 of the hoard" has no delivery (QuestGrants
## `ITEM_AMOUNT_UNSUPPORTED`) and ADR 0216 removed `reward_count` anyway.
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"core_max_qi", "value": 18.0},
	{"option_id": &"core_max_health", "value": 14.0},
])
roll_spec = {"count": 3, "contexts": ["prefix", "postfix"]}
subcategory = &"artifact"
stackable = false
grade = &"spirit"
sources = Array[StringName]([&"domain:loot_ember_vault_domain"])