[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"curr_spirit_coin"
display_name = "LOC_ITEMS_CURR_SPIRIT_COIN_DISPLAY_NAME"
category = &"currency"
; ADR 0094: "A numeraire must be `stackable`, `max_stack 9999`, `roll_spec = {}`, and carry
; a fixed base worth of 1.0." This file carried every one of those EXCEPT `max_stack`, so it
; inherited `ItemDef`'s default of 99. Money is a stackable item, so `Inventory._add_batch`
; chunks it at 99 per slot: a default 24-slot purse therefore holds at most 2376 coins, so a
; player carrying the suite's 5000 coins was ALREADY at 24/24 slots on arrival. Every
; purchase then refused `no_room` in `EconomyExchange` before it wrote anything, because the
; goods being bought had nowhere to arrive - the shelf was fine, the PURSE was full.
max_stack = 9999
rarity = &"common"
realm = &""
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"trade_value", "value": 1.0},
])
roll_spec = {}
subcategory = &"numeraire"
grade = &"mortal"
sources = Array[StringName]([&"starter"])