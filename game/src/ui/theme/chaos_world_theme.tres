[gd_resource type="Theme" load_steps=57 format=3]

; The single UI theme for the Chaos World UI program. Every control this program
; creates inherits it; no node carries a style or colour override. Rarity and
; message tone are expressed as Label theme type variations, not per-node
; colour edits, so the palette stays in one place.
;
; Typography: Inter is the default and Cinzel carries the two title roles. Cinzel has
; no Vietnamese, so it falls back to Inter — see fonts/display_font.tres for why that
; is load-bearing rather than tidiness.

[ext_resource type="FontVariation" path="res://src/ui/theme/fonts/body_font.tres" id="font_body"]
[ext_resource type="FontVariation" path="res://src/ui/theme/fonts/display_font.tres" id="font_display"]

