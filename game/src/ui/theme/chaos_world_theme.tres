; --- Codex variations: fate and destiny (ADR 0065) --------------------------
;
; A locked entry is never painted in the ink of an earned one. `LockedLabel` is
; the quiet end of the pair, and it is the same "empty" the game already uses for
; an absent but real value: `MetaLabel`'s grey body text, a step smaller, and a
; hairline `list_panel` card behind it. Gold is spent on the accents (screen
; title, prize, a filled seat) and never on a text that names what the hero
; still owes, so the two never read as one flat list.

FateNameLabel/colors/font_color = Color(0.898, 0.749, 0.318, 1)
FateNameLabel/font_sizes/font_size = 17
EarnedLabel/colors/font_color = Color(0.949, 0.851, 0.643, 1)
EarnedLabel/font_sizes/font_size = 17
LockedLabel/colors/font_color = Color(0.667, 0.639, 0.576, 1)
LockedLabel/font_sizes/font_size = 12

; The strongest weight in the codex goes to a held destiny — the narrative payoff
; — and to nothing else on this screen, so it cannot be confused with a fate name
; one step below it.
DestinyNameLabel/colors/font_color = Color(1, 0.965, 0.871, 1)
DestinyNameLabel/font_sizes/font_size = 20
DestinyLockedLabel/colors/font_color = Color(0.667, 0.639, 0.576, 1)
DestinyLockedLabel/font_sizes/font_size = 14

; The bearing is the author's voice, not body copy: a cool celadon sets it apart
; from the description's green, so a payoff never reads as a stat line.
BearingLabel/colors/font_color = Color(0.749, 0.878, 0.831, 1)
BearingLabel/font_sizes/font_size = 15

EarnedCard/styles/panel = SubResource("earned_card")
LockedCard/styles/panel = SubResource("locked_card")
DestinyCard/styles/panel = SubResource("destiny_card")
