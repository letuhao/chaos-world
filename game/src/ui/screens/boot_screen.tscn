[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/screens/boot_screen.gd" id="1"]
[ext_resource type="Theme" path="res://src/ui/theme/chaos_world_theme.tres" id="2"]

[node name="BootScreen" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"ScreenTitle"
text = "Chaos World"

[node name="Subtitle" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "A cultivation action RPG."

[node name="StatusLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "No hero bound."

[node name="ContinueButton" type="Button" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Continue"

[node name="NewGameButton" type="Button" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "New Game"

[node name="HintLabel" type="Label" parent="Layout"]
