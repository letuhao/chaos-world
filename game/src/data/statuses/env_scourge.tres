[gd_resource type="Resource" script_class="StatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/status_def.gd" id="1_status"]

[resource]
script = ExtResource("1_status")
id = &"env_scourge"
# No `element`, deliberately. `StatusDef.problems()` refuses an element-less def
# (`status_def.gd:186`) because every status in `res://data/statuses/` is inflicted by
# an element-bearing blow and needs one to name. This one is not: it is a PLACE, applied
# by standing in it, and a hazard is hostile to whichever elements its ZONE names
# (`EnvironmentField.HOSTILE_ELEMENTS`), not to one of its own. Naming `fire` here would
# be a lie the shipped catalogue would act on — `StatusApi.status_for_element` would
# answer with it for every fire blow in the game. So this def is authored for `domain`
# and read through `EnvironmentField.hazard_def()`, and `problems()` is deliberately
# NOT clean on it; the test asserts that rather than pretending.
element = &""
on_landed_blow = false
kind = &"dot"
scope = &"cultivation"
stacking = &"refresh"
duration = 8.0
magnitude_unit = &"health_share"
magnitude_cap = 2.0
tick_interval = 2.0
mitigation_tags = Array[StringName]([&"affinity", &"gear", &"technique", &"pill"])
payload = {
"mechanic": &"escalating_burn",
"text": "The air itself is against them. Standing still is the mistake: the longer they are in it, the deeper it settles.",
"pool": &"health",
"share_per_pulse": 0.03,
"escalation_per_tick": 0.06,
"escalation_cap": 2.0,
"modifiers": []
}