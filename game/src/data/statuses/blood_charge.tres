[gd_resource type="Resource" script_class="StatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/status_def.gd" id="1_status"]

[resource]
script = ExtResource("1_status")
id = &"blood_charge"
; Ambient (a body condition, not a blow): `element` empty and `ambient = true`, exactly
; as `env_scourge.tres` explains — the ambient tree is what a body carries rather than
; what a blow inflicts, and the twenty element ids stay the blow-inflicted set.
element = &""
ambient = true
on_landed_blow = false
kind = &"meter"
scope = &"cultivation"
stacking = &"refresh"
duration = 30.0
magnitude_unit = &"health_share"
magnitude_cap = 2.0
tick_interval = 1.0
mitigation_tags = Array[StringName]([&"affinity", &"gear", &"technique", &"pill"])
payload = {
"mechanic": &"bleed",
"text": "The wound keeps its own ledger: what it pays out feeds what it owes, and the debt comes due in one bite.",
"pool": &"health",
"share_per_pulse": 0.02,
; The threshold is the def's OWN cap (ADR 0902, P7): the meter fills to the ceiling
; this def already declares and discharges there. No second number to keep in step.
"meter": {"every": 2.0, "reset_on_burst": true},
"modifiers": []
}
