description = "The direction of the next act, projected mid-motion."
payload = {
"class": &"expression",
"shape": "",
"channel": &"intent",
"battlefield": "mind_status_mastery_intent",
"resist_stat": "mind_composure_",
"counterpart_id": &"mind_clarity",
"beat": 1.0,
"steepness": 0.45,
"harm": 0.2,
"floor_resist": 0.45,
"headroom": 0.35,
"duration": 3.0,
"magnitude_cap": 0.2,
"text": "Intent. The direction of the coming act, said aloud without being spoken: the target's composure is spent holding a purpose that is no longer the one they chose."
