[gd_resource type="Resource" script_class="MindStatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/mind_status_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"mind_clarity"
display_name = "Clarity"
role = &"composure"
description = "The composure that answers an Intent. Refilled on the target's own beat."
payload = {
"class": &"composure",
"shape": "",
"channel": &"intent",
"battlefield": "mind_composure_intent",
"resist_stat": "mind_composure_",
"counterpart_id": &"mind_intent",
"beat": 1.0,
"steepness": 0.45,
"recovery": 0.45,
"floor_resist": 0.45,
"headroom": 0.35,
"duration": 3.0,
"magnitude_cap": 0.2,
"text": "Clarity. The steadiness of purpose under motion, and the share of what was taken that comes back on the next beat."
}
