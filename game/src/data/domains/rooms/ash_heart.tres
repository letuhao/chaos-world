[ext_resource type="Script" path="res://src/modules/domain/environment_zone_def.gd" id="2_zone"]

[sub_resource type="Resource" id="zone_heart"]
script = ExtResource("2_zone")
zone_id = &"furnace_heart"
kind = &"super_hot"
intensity = 3
status_id = &"env_scourge"
stay_budget = 6.0
tags = Array[StringName]([&"fire", &"hostile_to_metal"])
mitigation_tags = Array[StringName]([&"gear", &"affinity"])
bounds = Rect2i(0, 0, 5, 5)

[resource]
script = ExtResource("1_room")
room_id = &"ash_heart"
display_name = "Heart of Ashes"
kind = &"core"
roster_band = &"boss"
tags = Array[StringName]([&"deep", &"hot"])
size = Vector2i(12, 10)
actor_spawn_refs = Array[Dictionary]([
	{"ref_id": &"ash_dragon", "inhabitant_id": &"flame_dragon", "role": &"boss", "count": 1}
])
fixtures = Array[Dictionary]([
	{"fixture_id": &"ash_heart_hoard", "kind": &"treasure", "tags": Array[StringName]([&"treasure_boss_sealed", &"deep"]), "position": Vector2i(8, 6), "bounds": Rect2i(8, 6, 3, 3), "reward_item_id": &"flame_dragon_heart_seal", "reward_count": 1, "key_item_id": &"", "requires_realm": &"core_formation", "telegraph_s": 0.0, "damage_share": 0.0, "status_id": &"", "duration_s": 0.0, "mitigation_tags": Array[StringName]([])}
])
environment_zones = Array[EnvironmentZoneDef]([SubResource("zone_heart")])