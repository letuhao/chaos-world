[ext_resource type="Script" path="res://src/modules/domain/environment_zone_def.gd" id="2_zone"]

[sub_resource type="Resource" id="zone_furnace"]
script = ExtResource("2_zone")
zone_id = &"furnace_bed"
kind = &"super_hot"
intensity = 2
status_id = &"env_scourge"
stay_budget = 8.0
tags = Array[StringName]([&"fire"])
mitigation_tags = Array[StringName]([&"technique", &"pill"])
bounds = Rect2i(4, 3, 4, 4)

[resource]
script = ExtResource("1_room")
room_id = &"ash_furnace"
display_name = "Ash Furnace"
kind = &"chamber"
roster_band = &"trial"
tags = Array[StringName]([&"inland", &"hot", &"furnace"])
size = Vector2i(10, 8)
actor_spawn_refs = Array[Dictionary]([
	{"ref_id": &"furnace_golem", "inhabitant_id": &"stone_golem", "role": &"miniboss", "count": 1}
])
environment_zones = Array[EnvironmentZoneDef]([SubResource("zone_furnace")])