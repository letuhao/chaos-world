[gd_resource type="Resource" script_class="RoomDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/modules/domain/room_def.gd" id="1_room"]
[ext_resource type="Script" path="res://src/modules/domain/environment_zone_def.gd" id="2_zone"]

[sub_resource type="Resource" id="zone_frost_lab"]
script = ExtResource("2_zone")
zone_id = &"frost_lab_chill"
kind = &"super_cold"
intensity = 2
status_id = &"env_scourge"
stay_budget = 8.0
tags = Array[StringName]([&"ice", &"frost"])
mitigation_tags = Array[StringName]([&"gear", &"technique"])
bounds = Rect2i(3, 2, 4, 4)

[resource]
script = ExtResource("1_room")
room_id = &"frost_laboratory"
display_name = "Frost Laboratory"
kind = &"chamber"
roster_band = &"trial"
tags = Array[StringName]([&"frozen", &"laboratory", &"trial"])
size = Vector2i(10, 8)
actor_spawn_refs = Array[Dictionary]([
	{"ref_id": &"frost_lab_sentinel", "inhabitant_id": &"frost_sentinel", "role": &"miniboss", "count": 2}
])
fixtures = Array[Dictionary]([
	{"fixture_id": &"frost_lab_seal", "kind": &"puzzle", "tags": Array[StringName]([&"puzzle_formation", &"puzzle_seal", &"frost", &"laboratory"]), "position": Vector2i(5, 4), "bounds": Rect2i(5, 4, 1, 1), "reward_item_id": &"frost_laboratory_seal_key", "reward_count": 1, "key_item_id": &"", "requires_realm": &"", "telegraph_s": 1.4, "damage_share": 0.0, "status_id": &"frost_bite", "duration_s": 5.0, "mitigation_tags": Array[StringName]([&"technique", &"pill"]), "nodes": Array[StringName]([&"water", &"wood", &"fire", &"metal"]), "sequence": Array[StringName]([&"wood", &"fire", &"metal", &"water"]), "wrong_status_id": &"frost_bite"}
])
environment_zones = Array[EnvironmentZoneDef]([SubResource("zone_frost_lab")])