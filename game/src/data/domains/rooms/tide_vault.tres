[gd_resource type="Resource" script_class="RoomDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/modules/domain/room_def.gd" id="1_room"]
[ext_resource type="Script" path="res://src/modules/domain/environment_zone_def.gd" id="2_zone"]

[sub_resource type="Resource" id="zone_tide"]
script = ExtResource("2_zone")
zone_id = &"tide_shallows"
kind = &"super_cold"
intensity = 2
status_id = &"env_scourge"
stay_budget = 9.0
tags = Array[StringName]([&"ice", &"water"])
mitigation_tags = Array[StringName]([&"gear", &"affinity"])
bounds = Rect2i(2, 2, 5, 4)

[resource]
script = ExtResource("1_room")
room_id = &"tide_vault"
display_name = "Tide Vault"
kind = &"chamber"
roster_band = &"boss"
tags = Array[StringName]([&"deep", &"cold", &"tide"])
size = Vector2i(10, 8)
actor_spawn_refs = Array[Dictionary]([
	{"ref_id": &"tide_sentinel", "inhabitant_id": &"frost_sentinel", "role": &"miniboss", "count": 1}
])
environment_zones = Array[EnvironmentZoneDef]([SubResource("zone_tide")])