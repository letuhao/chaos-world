[gd_resource type="Resource" script_class="RoomDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/modules/domain/room_def.gd" id="1_room"]
[ext_resource type="Script" path="res://src/modules/domain/environment_zone_def.gd" id="2_zone"]

[sub_resource type="Resource" id="zone_static"]
script = ExtResource("2_zone")
zone_id = &"charged_air"
kind = &"static"
intensity = 1
status_id = &"env_scourge"
stay_budget = 7.0
tags = Array[StringName]([&"lightning"])
mitigation_tags = Array[StringName]([&"technique", &"gear"])
bounds = Rect2i(1, 1, 4, 5)

[resource]
script = ExtResource("1_room")
room_id = &"storm_gallery"
display_name = "Storm Gallery"
kind = &"chamber"
roster_band = &"contact"
tags = Array[StringName]([&"inland", &"storm"])
size = Vector2i(9, 8)
actor_spawn_refs = Array[Dictionary]([
	{"ref_id": &"storm_acolyte", "inhabitant_id": &"storm_acolyte", "role": &"mob", "count": 2}
])
environment_zones = Array[EnvironmentZoneDef]([SubResource("zone_static")])