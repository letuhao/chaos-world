[gd_resource type="Resource" script_class="DomainTemplateDef" load_steps=11 format=3]

[ext_resource type="Script" path="res://src/modules/domain/domain_template_def.gd" id="1_template"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_floor.tres" id="2_floor"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_chamber.tres" id="3_chamber"]
[ext_resource type="Script" path="res://src/modules/domain/template_pin.gd" id="4_pin"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_camp.tres" id="5_camp"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/tide_vault.tres" id="6_vault"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/storm_gallery.tres" id="7_gallery"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_gate.tres" id="8_gate"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_arena.tres" id="9_arena"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_heart.tres" id="10_heart"]

[sub_resource type="Resource" id="pin_camp"]
script = ExtResource("4_pin")
leaf_index = 3
room_def = ExtResource("5_camp")
kind = &"settlement"
display_name = "Pilgrim Camp"

[sub_resource type="Resource" id="pin_vault"]
script = ExtResource("4_pin")
leaf_index = 14
room_def = ExtResource("6_vault")
kind = &"boss"
display_name = "Drowned Vault"

[resource]
script = ExtResource("1_template")
template_id = &"stormwrack_reach"
display_name = "Stormwrack Reach"
# Domain-level weather (ADR 0075). Read by `DomainBoot._template_weather` and refused
# through `DomainMap.accepts_weather` unless it is in `DomainMap.WEATHERS`. This pool
# authors a `lightning` zone (storm_gallery) AND a `cold`/`ice`/`water` zone (tide_vault),
# so this weather moves exactly the first and leaves the drowned vault alone: the bias
# is element-keyed, never "everything is worse".
weather = &"storm_gale"
extent = Vector2i(128, 96)
min_leaf = 8
max_depth = 6
split_ratio_range = Vector2(0.4, 0.6)
repeat_axis_chance = 0.25
margin = 1
loop_ratio = 0.22
max_loop_edges = 8
loop_gap_tiles = 6
corridor_tiles = 3
min_rooms = 9
max_rooms = 26
# Every def in the 8-room pool is built on every seed, or the seed is refused rather
# than shipped with a hole in its kit. Nine leaves are guaranteed, eight defs have to
# fit them, and both pins name distinct pool defs, so one leaf is spare.
requires_full_kit = true
entry_anchor = Vector2i(3, 3)
room_pool = Array[RoomDef]([
	ExtResource("2_floor"),
	ExtResource("3_chamber"),
	ExtResource("5_camp"),
	ExtResource("7_gallery"),
	ExtResource("6_vault"),
	ExtResource("8_gate"),
	ExtResource("9_arena"),
	ExtResource("10_heart")
])
pins = Array[TemplatePin]([SubResource("pin_camp"), SubResource("pin_vault")])