[gd_resource type="Resource" script_class="DomainTemplateDef" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/modules/domain/domain_template_def.gd" id="1_template"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_floor.tres" id="2_floor"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/frost_laboratory.tres" id="3_lab"]
[ext_resource type="Script" path="res://src/modules/domain/template_pin.gd" id="4_pin"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_camp.tres" id="5_camp"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_gate.tres" id="6_gate"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/frost_throne.tres" id="7_throne"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_chamber.tres" id="8_chamber"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ember_larder.tres" id="9_larder"]

[sub_resource type="Resource" id="pin_camp"]
script = ExtResource("4_pin")
leaf_index = 2
room_def = ExtResource("5_camp")
kind = &"settlement"
display_name = "Pilgrim Camp"

[sub_resource type="Resource" id="pin_throne"]
script = ExtResource("4_pin")
leaf_index = 6
room_def = ExtResource("7_throne")
kind = &"boss"
display_name = "Frost Throne"

[resource]
script = ExtResource("1_template")
template_id = &"frozen_cavern"
display_name = "Frozen Cavern"
# Domain-level weather (ADR 0075). Read by `DomainBoot._template_weather` and refused
# through `DomainMap.accepts_weather` unless it is in `DomainMap.WEATHERS`. This pool
# authors an `ice` zone (frost_laboratory, frost_throne), so this weather moves exactly
# those zones one band hotter than authored; zones that name no element are untouched.
weather = &"rime_mist"
extent = Vector2i(80, 56)
min_leaf = 7
max_depth = 5
split_ratio_range = Vector2(0.4, 0.6)
repeat_axis_chance = 0.25
margin = 1
loop_ratio = 0.18
max_loop_edges = 6
loop_gap_tiles = 6
corridor_tiles = 2
min_rooms = 6
max_rooms = 14
# Every def in the 6-room pool is built on every seed, or the seed is refused rather
# than shipped with a hole in its kit. Seven leaves are guaranteed, six defs have to
# fit them, and both pins name distinct pool defs, so one leaf is spare.
requires_full_kit = true
entry_anchor = Vector2i(3, 3)
room_pool = Array[RoomDef]([
	ExtResource("2_floor"),
	ExtResource("3_lab"),
	ExtResource("5_camp"),
	ExtResource("6_gate"),
	ExtResource("7_throne"),
	ExtResource("8_chamber"),
	ExtResource("9_larder")
])
pins = Array[TemplatePin]([SubResource("pin_camp"), SubResource("pin_throne")])