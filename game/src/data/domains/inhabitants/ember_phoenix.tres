[resource]
script = ExtResource("1_def")
inhabitant_id = &"ember_phoenix"
display_name = "Ember Phoenix"
realm_id = &"spirit_transformation"
base = {&"physique": 25.0, &"spirit": 28.0, &"aptitude": 14.0, &"comprehension": 16.0, &"agility": 18.0, &"will": 22.0, &"fortune": 7.0}
