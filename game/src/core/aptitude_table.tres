[gd_resource type="Resource" script_class="AptitudeTable" load_steps=2 format=3]

; The seed aptitude matrix (ADR 0882). One row per edge:
; {channel, source, k, mode}. CONTEST rows are ladder-free; MAGNITUDE rows read the
; actor's ladder value (its realm power, pushed by RealmScaling) — and a MAGNITUDE row
; must never target a RealmScaling.SCALED_STATS channel, which the ladder already
; scales, NOR a channel a CONSUMER reads against a FIXED SCALE: `damage_reduction` is
; clamped to `CombatTuning.damage_reduction_cap` and `amplification` is divided by the
; constant `amp_scale` at S7, so under MAGNITUDE the ladder saturates both — measured
; `damage_reduction` 0.1425 -> 2.2978 across R21..R30 (the blow a defender takes fell to
; x0.10, and once that was fixed the LADDER-scaled `amplification` overshot the other
; way, a 9-blow fight against the anchor's 23; DEF-0384). Both are CONTEST for the same
; reason the status channels are.
;
; The coefficients are an INITIAL AUTHORED PASS, not balance: retune by editing here.
;
; The status channels (status.power.omni / status.intensity.omni / status.resist.omni /
; status.duration.omni / status.durationReduction.omni) are produced BY THE BUILD
; (DEF-0346, duration added under DEF-0352). CONTEST mode on all of them (ADR 0891): the
; gate and the net factors read ONE FIXED scale over the delta, and a realm-scaled input
; saturates that scale — any epsilon of advantage would read certainty at R30 while the
; same shares read a real fraction at R1. The ladder belongs to the base magnitude
; (`element_power`), never to the contest.
; `might` and `ferocity` both feed the offense half; `focus` the potency AND the duration;
; `composure` the resistance AND the duration reduction. The same `composure` feeds the
; LEECH answer half for every pool (leech_resist.health/.qi/.stamina, ADR 0889) — a
; CONTEST rate, so the defender's answer is a share of the build like every other contest
; input (ADR 0891).

[ext_resource type="Script" path="res://src/core/aptitude_table.gd" id="1"]

[resource]
script = ExtResource("1")
edge_rows = Array[Dictionary]([
{"channel": &"attack_physical", "source": &"might", "k": 0.4, "mode": "contest"},
{"channel": &"attack_spiritual", "source": &"might", "k": 0.4, "mode": "contest"},
{"channel": &"amplification", "source": &"might", "k": 0.2, "mode": "contest"},
{"channel": &"defense_physical", "source": &"fortitude", "k": 0.4, "mode": "contest"},
{"channel": &"defense_spiritual", "source": &"fortitude", "k": 0.4, "mode": "contest"},
{"channel": &"absorption", "source": &"fortitude", "k": 0.2, "mode": "magnitude"},
{"channel": &"damage_reduction", "source": &"fortitude", "k": 0.05, "mode": "contest"},
{"channel": &"shield.capacity", "source": &"vigor", "k": 0.3, "mode": "magnitude"},
{"channel": &"shield.regen", "source": &"vigor", "k": 0.02, "mode": "magnitude"},
{"channel": &"shield.toughness", "source": &"vigor", "k": 0.05, "mode": "magnitude"},
{"channel": &"parry.break", "source": &"onslaught", "k": 0.008, "mode": "contest"},
{"channel": &"block.break", "source": &"onslaught", "k": 0.008, "mode": "contest"},
{"channel": &"evasion", "source": &"agility", "k": 0.008, "mode": "contest"},
{"channel": &"attack_speed", "source": &"agility", "k": 0.05, "mode": "contest"},
{"channel": &"crit_resist", "source": &"composure", "k": 0.008, "mode": "contest"},
{"channel": &"crit_resist_damage", "source": &"composure", "k": 0.05, "mode": "contest"},
{"channel": &"penetration.rate", "source": &"pierce", "k": 0.2, "mode": "magnitude"},
{"channel": &"shield.pen", "source": &"pierce", "k": 0.1, "mode": "magnitude"},
{"channel": &"max_qi", "source": &"focus", "k": 0.3, "mode": "contest"},
{"channel": &"qi_regen", "source": &"focus", "k": 0.05, "mode": "magnitude"},
{"channel": &"qi_cost_reduction", "source": &"focus", "k": 0.02, "mode": "contest"},
{"channel": &"parry.rate", "source": &"bulwark", "k": 0.006, "mode": "contest"},
{"channel": &"block.rate", "source": &"bulwark", "k": 0.006, "mode": "contest"},
{"channel": &"parry.strength", "source": &"bulwark", "k": 0.2, "mode": "contest"},
{"channel": &"block.strength", "source": &"bulwark", "k": 0.2, "mode": "contest"},
{"channel": &"reflect.rate", "source": &"retribution", "k": 0.006, "mode": "contest"},
{"channel": &"reflect.damage", "source": &"retribution", "k": 0.05, "mode": "contest"},
{"channel": &"accuracy", "source": &"precision", "k": 0.008, "mode": "contest"},
{"channel": &"crit_chance", "source": &"ferocity", "k": 0.008, "mode": "contest"},
{"channel": &"crit_damage", "source": &"ferocity", "k": 0.1, "mode": "contest"},
{"channel": &"status.power.omni", "source": &"might", "k": 0.2, "mode": "contest"},
{"channel": &"status.power.omni", "source": &"ferocity", "k": 0.15, "mode": "contest"},
{"channel": &"status.intensity.omni", "source": &"focus", "k": 0.2, "mode": "contest"},
{"channel": &"status.resist.omni", "source": &"composure", "k": 0.2, "mode": "contest"},
{"channel": &"status.duration.omni", "source": &"focus", "k": 0.15, "mode": "contest"},
{"channel": &"status.durationReduction.omni", "source": &"composure", "k": 0.15, "mode": "contest"},
{"channel": &"leech_resist.health", "source": &"composure", "k": 0.008, "mode": "contest"},
{"channel": &"leech_resist.qi", "source": &"composure", "k": 0.008, "mode": "contest"},
{"channel": &"leech_resist.stamina", "source": &"composure", "k": 0.008, "mode": "contest"},
])
share_exponent = 1.0
contest_span = 1.0
