"vascular": [0.5, 0.75, 1.25],
"visceral": [0.75, 0.5, 1.5]
}
integrity_pool_id = &"body_integrity"
acupoint_data_dir = "res://data/body_cultivation/acupoints"
wound_threshold = 0.05
necrosis_threshold = 0.25
necrosis_quality = 0.3
wound_decay = 0.01