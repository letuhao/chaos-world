[gd_resource type="Resource" script_class="CombatTuning" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/combat_engine/combat_tuning.gd" id="1"]

[resource]
script = ExtResource("1")
min_chip_abs = 1.0
min_chip_share = 0.01
avoidance_band_cap = 0.95
chain_depth_limit = 6
; ADR 0877. The flat-delta exchange rate: `p = clampf(maxf(0, rate - resist) /
; rate_scale, 0, 1)`. `0.01` against the current magnitudes: the stock attack carries
; `accuracy` 0.005 against a body with no evasion, and one agility point moves a contest
; by `0.0015..0.002 / 0.01` = 15..20 percent. The old `1000.0` was the permille divisor
; of a `[0, 1]`-space formula that no longer ships; at these magnitudes it would read
; every trigger as `0.0`. Retuning a trigger is this one line.
rate_scale = 0.01
; ADR 0878. The removal CAP for a landed parry or block: a response can never remove
; more than this share of a landed blow. `0.95` is Keepverse's own per-response cap and
; mirrors this file's `avoidance_band_cap` rationale on a different output -- an
; anti-immunity bound. At `0.0` a response would remove nothing, which is the
; degenerate state a caller without this file gets.
refusal_cap = 0.95
amp_scale = 10.0
lifesteal_pool = &"health"
; BL-0348's ruling: an un-authored attack is PHYSICAL by default. `0.8` routed 80% of
; every un-authored attack through the element path -- a different game from `0.0`. At
; `0.0` a technique that wants an elemental term AUTHORS its share, which every shipped
; elemental technique already does; an elementless or un-authored blow is pure physical.
default_element_share = 0.0
; ADR 0200. `resist_divisor` still puts `element_defense_<e>` into the same magnitude
; space as `element_power_<e>`, and it stays at `100.0` because the shipped
; `ElementProvider` still contributes defense as `affinity * 0.5 + will * 0.2` against
; power as `affinity * (1 + mastery * 0.1 / tier_divisor)`. The arithmetic around it is
; what changed: the defense term is no longer divided into a `[0, 1]` percent by a FIXED
; divisor and clamped, it is the `D` of a ratio whose other half rides the attacker.
resist_divisor = 100.0
; ADR 0200. THE CEILING IS A MULTIPLIER, NEVER A CLAMP.
;
; `resist_cap = 0.75` is deleted. It was `min(0.75, D/100 - pen)`, and a clamp on an
; INPUT is the defect: at one point of defense past the clamp the stat was simply dead,
; forever, at every realm. The replacement is `m = mitigation_ceiling * D / (K + D)` with
; `K = defense_divisor_k * offense`, so `m` APPROACHES `mitigation_ceiling` and never
; reaches it -- every further point of defense still pays, which is the property the cap
; destroyed.
;
; `0.95` is the ADR's own number. The old three caps (0.75 elemental, 0.6 mental,
; 0.8 illusion) are all one number now, and it is a multiplier on a curve rather than a
; bound on a stat.
mitigation_ceiling = 0.95
; ADR 0200. `K = defense_divisor_k * offense`, the fraction of the ATTACKER's own
; magnitude the defender's defense is measured against. `0.45` is the ADR's number and
; it is PER MECHANISM: the owner ruled that qi, body and mind each set their own so the
; three stay independent. This line is qi's.
;
; Reading it at the shipped values: an R1 qi attacker carries `element_power_lightning`
; of `10.0` (fixture affinity `10.0`, mastery 0) against a defender whose
; `element_defense_lightning` is `5.0`, so `K = 4.5`, `D = 5.0` and
; `m = 0.95 * 5.0 / 9.5 = 0.5000`. A stock actor's `affinity 2.0` race reads
; `element_defense = 1.0` against the same attacker, so `m = 0.95 * 1.0 / 5.5 = 0.1727` --
; and both RISE with the ladder rather than pinning at a ceiling, which is the whole
; point. `resist_cap` at the same two cases read a flat `0.01` and `0.75`.
defense_divisor_k = 0.45
; ADR 0200. `D_eff = D * 1 / (1 + max(0, pen) / pierce_scale)`. Bounded in `(0, 1]`: a
; penetration of `10.0` halves any defense, `100.0` cuts it to a tenth, and it can never
; drive defense NEGATIVE. `10.0` is the ADR's number.
;
; This replaces a subtraction FROM THE DAMAGE, which is dimensionally wrong -- penetration
; is a share of the defender's armor, not hit points off the gross -- and the old shape's
; real failure was that a big enough penetration subtracted straight past zero and turned
; a defended point into a free one. `body_damage.gd` is where that defect lived.
pierce_scale = 10.0
damage_reduction_cap = 0.9
element_power_prefix = "element_power_"
resist_resistance_prefix = "element_defense_"
element_crit_prefix = "element_crit_"
element_crit_resist_prefix = "element_crit_resist_"
default_mind_share = 1.0
; ADR 0200. `mental_defense_cap = 0.6` and `illusion_resistance_cap = 0.8` are both
; DELETED, and mind now reads the same `mitigation_ceiling` / `defense_divisor_k` /
; `pierce_scale` every other mechanism does. Those two numbers were ceilings on INPUTS:
; `mind_damage.gd` hard-clamped `d/(d+base)` at `0.6`, so 40% of every mind strike landed
; at any `mental_clarity` and at any realm, and no amount of `mental_defense` ever moved
; that. With the clamp gone, `m = 0.95 * D / (K + D)` keeps RISING with defense and
; approaches `0.95` asymptotically.
;
; What survives of the 40% floor is the ASYMPTOTE rather than the clamp: a mind strike
; lands at least `1 - 0.95 = 0.05` of itself at every defense, because `m` is strictly
; below the ceiling for every finite `D`. That is the mind analogue of the spine's chip
; floor and it is now a property of the curve rather than of an authored number.
; `MindDamage.defense_floor()` publishes it.
coherence_damp = 0.5
focus_mult = 2.0
turbulence_to_clarity = 0.5
rupture_threshold = 0.7
rupture_bleed = 0.15
rupture_collapse_time = 3.0
collapse_clarity_floor = 0.15
collapse_capacity_floors = {
"deep": 300.0,
"shallow": 100.0
}
collapse_deviation_duration = 60.0
mind_stat_prefix = ""
sea_component = &"sea_of_consciousness"
awareness_pool_id = &"awareness"
health_pool_id = &"health"
mind_deviation_stat = "mind_technique_power"
; The BASE status gate, MOVED here from `CombatExchange.STATUS_GATE_CHANCE` (DEF-0145).
; ADR 0105 recorded this exact move as its standing debt and said so verbatim: "add
; `@export var status_gate_chance: float = 0.0` to `CombatTuning`, author it in
; `combat_damage.tres` at `1.0`, and make this read `CombatEngineApi.tuning()
; .status_gate_chance` -- the call site below is already shaped for exactly that
; substitution". ADR 0087's consequence makes it a `.tres` field rather than a `.gd`
; constant: its numbers are "provisional ... re-tuned by an edit, never by an ADR".
;
; THE VALUE IS UNCHANGED AT 1.0. This change moved the dial, it did not move the dial's
; value: 1.0 is what shipped and the shipped rate is what was measured. Under ADR 0884's
; flat contest what 1.0 means is `gate * p_apply`, with `p_apply = clampf(0.5 +
; (power - resist) / (2 * status_rate_scale), 0.0, 1.0)` -- parity reads HALF, not
; certainty. A balance pass now edits this ONE line rather than editing a `.gd`.
status_gate_chance = 1.0
status_min_apply = 0.01
; ADR 0902 (P4). The fallback re-application lockout; 0.0 = no ICD. Pushed into
; StatusApi.set_icd_default at boot -- the status module owns the clock it reads.
status_icd_default = 0.0
; ADR 0902 (P10). The apply-chance SHAPE: "linear" is the shipped parity-half reading
; (byte-identical); "sigmoid" is Keepverse's shape, 0.5 at its own zero. status_apply_offset
; shifts the neutral point (the measured CC-lock dial), status_apply_steepness steepens the
; sigmoid, and the two *_by_category maps override scale/steepness per authored category.
; The realm power gap is deliberately NOT a term here (ADR 0906): the measured raw gap
; saturates the 0..1 delta at any live weight, so the knob was deleted, not defaulted.
status_apply_shape = &"linear"
status_apply_offset = 0.0
status_apply_steepness = 1.0
status_apply_scale_by_category = {}
status_apply_steepness_by_category = {}
status_power_prefix = "status.power."
status_resist_prefix = "status.resist."
status_rate_scale = 0.5
status_intensity_prefix = "status.intensity."
status_intensity_reduction_prefix = "status.intensityReduction."
status_duration_prefix = "status.duration."
status_duration_reduction_prefix = "status.durationReduction."
status_immune_prefix = "status.immune."
status_immune_reduction_prefix = "status.immuneReduction."
status_net_factor_scale = 1.0
status_min_net_factor = 0.0
status_max_net_factor = 3.0
; Status potency, retuned as TUNING. ADR 0087's own note calls these provisional
; numbers, so a rebalance is a `.tres` edit and never a literal in logic. The shape is
; UNCHANGED and still `StatusApply.potency_of`'s:
;   `potency = maxf(status_potency_floor, element_power_<e> * status_potency_scale)`.
;
; Measured before this edit: `element_power_<e>` spans 0.10 (the shipped `commonborn`
; race at 2.0 affinity, mastery 0) to 1.20 (affinity 1.0 at mastery 10, tier 1). At the
; old scale of 0.25 that whole band mapped to 0.025..0.30 against a floor of 1.0, so
; potency had to see power > 4.0 to leave the floor and EVERY build in the game landed at
; exactly 1.0 — two different attackers dealt identical status damage. Both numbers move
; together for one reason: a floor above the top of the realistic band is a CEILING.
;
; `status_potency_floor` 1.0 -> 0.1. It is the potency an actor with no elemental power
; at all still inflicts, and 0.1 keeps that guarantee (ADR 0088's reason for having a
; floor) while moving it below the bottom of the band, so the channel is live for every
; build rather than for none. The two shapes that could have fixed this WITHOUT moving a
; floor were rejected: raising `status_potency_scale` alone still floors every shipped
; build (you would need ~10.0, which overruns the authored `magnitude_cap` of every
; shipped `element_power` def), and `1 + scale * power` would have left potency at 1.0
; for a body with no elemental power — strictly weaker than a floor.
;
; `status_potency_scale` 2.5 -> 1.5. Over the realistic band this maps 0.10..1.20 onto
; 0.15..1.80: a ~12x spread across builds, and the top of the band stays under EVERY
; authored `magnitude_cap` of the shipped DoTs, not just the biggest one. At 2.5 the
; band top read 10.0, which OVERRAN `wind_gust`'s authored cap of 7.0 and
; `lightning_arc`'s 9.0 outright -- a cap is authored data
; (`modules/status/status_def.gd`: "the one ceiling that IS authored") and potency has
; no way to honour one it does not know about, so a balance pass would have had to audit
; all twenty status `.tres` to retune its own. The binding ceiling is the SMALLEST
; `element_power` cap in the catalogue, not the largest; 1.5 keeps the whole 7.0..10.0
; range reachable and the spread this tuning exists to produce, and going higher needs a
; cap audit on every authored def; going lower flattens the spread.
;
; ## ADR 0088 is untouched by either number
;
; Potency still reads ONLY `element_power_<e>` — no new stat id, no new authored option,
; no new read site — and mastery still reaches potency exactly once, through the provider's
; existing `affinity * (1 + mastery * 0.1 / tier_divisor)` contribution. Penetration is
; still `CombatStats.PENETRATION`, read once in `elemental_resist` and never in
; `potency_of`, so one investment buys "your status lands more often" and never also
; "your status hits harder".
status_potency_scale = 1.5
status_potency_floor = 0.1
status_default_duration = 6.0
min_penetration_ratio = 0.1
meridian_armour_step = 0.35
point_quality_step = 0.5
channel_mult_step = 0.15
injured_mult_step = 0.25
; `blocked_mult` 1.5 -> 1.6. ADR 0070's inversion and `combat_tuning.gd`'s own
; PRECONDITION of this field both say a jammed acupoint must outrank EVERY open one,
; and the whole quality range IS the maximum open point: `1 + point_quality_step x 1.0`
; = 1.5. The shipped `1.5` therefore TIED the best-trained acupoint exactly, so `random`
; aim could only ever find a jam on the lowest-id tie-break, not because the jam was
; the better aim point. `1.6` is the smallest change that makes the ordering STRICT,
; and it keeps the quality range the 50% swing it was authored as: an untrained point
; reads 1.0, a perfectly trained one 1.5, and the jam is worth a further 0.1 above the
; best of them. A larger figure would make the whole quality axis irrelevant to aim,
; which is the other way to break ADR 0070 rather than satisfy it.
blocked_mult = 1.6
broad_mult = 0.35
tissue_scale = 1.0
tissue_stat_divisor = 10.0
tissue_stat_ids = PackedStringArray("bone_density", "muscle_fiber", "organ_vitality")
meridian_archetypes = {
"bladder": "skeletal",
"chong_mai": "visceral",
