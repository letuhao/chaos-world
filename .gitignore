# Godot generated import cache
game/.godot/

# Build output
build/

# Private generated character asset folders. Keep the catalog and tags at the parent path tracked.
game/assets/characters/*/

# Asset proof-of-concept review folder (local only, never committed)
poc/

# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Local agent state (not shared)
.pi/
.remember/

# Harness-local skill installs — canonical copy is .agents/ + skills-lock.json
.claude/
.commandcode/

# Local Godot binary location
.godot-bin

# Tool run output (regenerated by every `tools` invocation; never source)
*.log
*.err

# OS noise
.DS_Store
Thumbs.db
