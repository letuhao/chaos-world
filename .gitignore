# Godot generated import cache
game/.godot/

# Build output
build/

# A probe redirect whose env var did not expand created a directory LITERALLY named
# "%GODOT_LOG_DIR%" at the repo root, and a blanket `git add -A` (1ae260003) committed
# 40 of its gate dumps — 1.4 MB of regenerable output. `*.log` below did not catch them
# because the redirect named them `.txt`. Probes belong under `build/` (INC-0021).
%GODOT_LOG_DIR%/
%GODOT_LOG_DIR%*/

# Private generated character asset folders. Keep the catalog and tags at the parent path tracked.
game/assets/characters/*/

# ...except the committed FALLBACK faces. Every authored PortraitDef under
# res://data/portraits/ is tracked and names a layer, and the art those layers point at is
# untracked by the rule above — so on a clean clone every portrait is an empty box, including
# the ones that resolve on the machine that generated them. These five are ~2 KB silhouettes,
# not art: they exist so an authored resource never names a file the repository does not have
# (ADR 0238). Real renders stay private and regenerable.
!game/assets/characters/portraits/
!game/assets/characters/portraits/*.png
!game/assets/characters/portraits/*.png.import

# Private content repo (unique characters + exclusive content, not shared)
game/assets/characters/unique/

# Asset proof-of-concept review folder (local only, never committed)
poc/

# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Local agent state (not shared)
.pi/
.remember/
# A stray recursive copy of the whole repo, committed by accident in 972b01f2e
# ("add"). It duplicates every tracked path and `godot_bypass` correctly reads it
# as 11 bare Godot invocations — the exact INC-0009 shape. The two ADRs it held
# and nothing else did (0240, 0241) have been recovered to `docs/adr/`.
.auditcopy/

# Harness-local skill installs — canonical copy is .agents/ + skills-lock.json
.claude/
.commandcode/

# Local Godot binary location
.godot-bin

# Tool run output (regenerated by every `tools` invocation; never source)
*.log
*.err

# High-resolution map source images stay local; indexed runtime canvases are the shipped assets.
/art-source/map-originals/
game/assets/packs/*/original/

# OS noise
.DS_Store
Thumbs.db
blender/
scratchpad/
