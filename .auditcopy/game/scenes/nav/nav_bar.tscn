[gd_scene load_steps=2 format=3]

; App-owned navigation hub. The shell mounts this above the screen stack, so it
; stays live no matter which screen is on top: every route is one button press or
; one digit away from anywhere in the game.
;
; The buttons are authored, one per slot, because the count comes from the route
; table at runtime. NavBar binds slot N to route N and reports a mismatch loudly
; rather than quietly rendering fewer destinations than the table promises.

[ext_resource type="Script" path="res://src/app/nav_bar.gd" id="1"]

[node name="NavBar" type="PanelContainer"]
layout_mode = 2
script = ExtResource("1")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="RouteRow" type="HBoxContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2

[node name="Slot0Button" type="Button" parent="Layout/RouteRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Route slot 1"
text = "1"

[node name="Slot1Button" type="Button" parent="Layout/RouteRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Route slot 2"
text = "2"

