[gd_resource type="Resource" script_class="DomainTemplateDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/modules/domain/domain_template_def.gd" id="1_template"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_floor.tres" id="2_floor"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_chamber.tres" id="3_chamber"]
[ext_resource type="Script" path="res://src/modules/domain/template_pin.gd" id="4_pin"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_camp.tres" id="5_camp"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_gate.tres" id="6_gate"]
[ext_resource type="Resource" path="res://src/data/domains/rooms/ash_arena.tres" id="7_arena"]

[sub_resource type="Resource" id="pin_camp"]
script = ExtResource("4_pin")
leaf_index = 2
room_def = ExtResource("5_camp")
kind = &"settlement"
display_name = "Pilgrim Camp"

[resource]
script = ExtResource("1_template")
template_id = &"ember_grotto"
display_name = "Ember Grotto"
# Domain-level weather (ADR 0075). Read by `DomainBoot._template_weather` and refused
# through `DomainMap.accepts_weather` unless it is in `DomainMap.WEATHERS`. Every zone
# this template's pool authors that names `fire` in its own tags runs one band hotter
# than it was authored; zones that name no element are untouched.
weather = &"ember_heat"
extent = Vector2i(72, 48)
min_leaf = 7
max_depth = 5
split_ratio_range = Vector2(0.4, 0.6)
repeat_axis_chance = 0.25
margin = 1
loop_ratio = 0.0
max_loop_edges = 0
loop_gap_tiles = 6
corridor_tiles = 2
min_rooms = 6
max_rooms = 10
# Every def in the 5-room pool is built on every seed, or the seed is refused rather
# than shipped with a hole in its kit. Six leaves are guaranteed, and five defs have
# to fit them, with the single pin naming a pool def.
requires_full_kit = true
entry_anchor = Vector2i(3, 3)
room_pool = Array[RoomDef]([
	ExtResource("2_floor"),
	ExtResource("3_chamber"),
	ExtResource("5_camp"),
	ExtResource("6_gate"),
	ExtResource("7_arena")
])
pins = Array[TemplatePin]([SubResource("pin_camp")])