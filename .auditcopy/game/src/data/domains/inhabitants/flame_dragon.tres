[gd_resource type="Resource" script_class="InhabitantDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/domain/inhabitant_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
inhabitant_id = &"flame_dragon"
display_name = "Flame Dragon"
realm_id = &"spirit_transformation"
base = {&"physique": 31.0, &"spirit": 25.0, &"aptitude": 13.0, &"comprehension": 15.0, &"agility": 15.0, &"will": 24.0, &"fortune": 5.0}
cultivates = true
hostile = true
# ADR 0230: the survivability a species is priced in BLOWS, not vitality. Unset, the pool
# is whatever `50 + physique * 10` scaled by `spirit_transformation` happens to be, and the
# boss band's only `boss`-role door stood at 360.0 — a fight whose length content never
# chose.
blows_to_survive = 6.0
# ADR 0235's authored boss turn. Absent, a `boss` role fights arithmetically like a mob.
boss_spec = {
"interval": 1.4,
"punish_window_blows": 2
}
tags = Array[StringName]([&"beast", &"ember", &"wyrm", &"ancient"])