# ADR 0230 / ADR 0235. The `tide_vault` door is `roster_band: boss`, so this species is
# what stands in it, and a band door whose occupant authors neither a survivability nor a
# turn is a door with a fight content never priced.
blows_to_survive = 5.0
boss_spec = {
"interval": 1.2,
"punish_window_blows": 1
}
tags = Array[StringName]([&"construct", &"frost", &"warden"])