[gd_resource type="Resource" script_class="RoomDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/modules/domain/room_def.gd" id="1_room"]
[ext_resource type="Script" path="res://src/modules/domain/environment_zone_def.gd" id="2_zone"]

[sub_resource type="Resource" id="zone_static"]
script = ExtResource("2_zone")
zone_id = &"charged_air"
kind = &"static"
intensity = 1
status_id = &"env_scourge"
stay_budget = 7.0
tags = Array[StringName]([&"lightning"])
mitigation_tags = Array[StringName]([&"technique", &"gear"])
bounds = Rect2i(1, 1, 4, 5)

[resource]
script = ExtResource("1_room")
room_id = &"storm_gallery"
display_name = "Storm Gallery"
kind = &"chamber"
roster_band = &"contact"
tags = Array[StringName]([&"inland", &"storm"])
size = Vector2i(9, 8)
actor_spawn_refs = Array[Dictionary]([
	{"ref_id": &"storm_acolyte", "inhabitant_id": &"storm_acolyte", "role": &"mob", "count": 2}
])
fixtures = Array[Dictionary]([
	{"fixture_id": &"storm_gallery_arc", "kind": &"trap", "tags": Array[StringName]([&"trap_vein", &"storm", &"lightning"]), "position": Vector2i(2, 2), "bounds": Rect2i(2, 2, 2, 3), "reward_item_id": &"", "reward_count": 0, "key_item_id": &"", "requires_realm": &"", "telegraph_s": 0.9, "damage_share": 0.06, "status_id": &"lightning_arc", "duration_s": 5.0, "mitigation_tags": Array[StringName]([&"gear", &"technique"])},
	{"fixture_id": &"storm_gallery_vent", "kind": &"trap", "tags": Array[StringName]([&"trap_vein", &"storm", &"wind"]), "position": Vector2i(6, 6), "bounds": Rect2i(6, 6, 2, 2), "reward_item_id": &"", "reward_count": 0, "key_item_id": &"", "requires_realm": &"", "telegraph_s": 1.1, "damage_share": 0.05, "status_id": &"wind_gust", "duration_s": 6.0, "mitigation_tags": Array[StringName]([&"pill", &"affinity"])}
])
environment_zones = Array[EnvironmentZoneDef]([SubResource("zone_static")])