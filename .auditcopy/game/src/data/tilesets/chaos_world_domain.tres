[gd_resource type="TileSet" load_steps=2 format=3]

; ONE atlas source, ONE terrain set, ONE physics layer (ADR 0072's `DomainScene`).
;
; Room tiles and corridor tiles are the SAME atlas tile, so the seam where a corridor
; leaves a room is not a case anything downstream has to special-case — there is no second
; tile for it to be. Walls are a different tile of the SAME source rather than a second
; source, so both layers share one terrain set and one physics layer by construction.
;
; The 32 px region is deliberate: `TILE_PIXELS` in `res://src/app/domain_scene.gd` must
; match `texture_region_size` here, because that constant is the only thing converting the
; map's tile coordinates into pixels, and the two files cannot read each other. The equality
; is asserted by `tests/modules/domain/test_domain_scene.gd` rather than assumed.
;
; The texture is the shipped 128x128 ground tile, sliced into a 4x4 grid of 32 px cells, so
; the floor is drawn from real repo art and no asset was authored for this.

[ext_resource type="Texture2D" path="res://assets/world_map/mortal_plains/ground_tile/base_ground.png" id="1_ground"]

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_domain_terrain"]
texture = ExtResource("1_ground")
texture_region_size = Vector2i(32, 32)
0:0/0 = 0
0:1/0 = 0
0:2/0 = 0
0:3/0 = 0
1:0/0 = 0
1:1/0 = 0
1:2/0 = 0
1:3/0 = 0
2:0/0 = 0
2:1/0 = 0
2:2/0 = 0
2:3/0 = 0
3:0/0 = 0
3:1/0 = 0
3:2/0 = 0
3:3/0 = 0
; The ONLY tile in the set that collides. The quad is full-tile and centred on the tile's
; own origin — `TileData` polygon points are tile-local and centred, so an off-centre quad
; would leave the wall's outer quarter walkable.
2:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-16, -16, 16, -16, 16, 16, -16, 16)

[resource]
physics_layer_0/collision_layer = 1
physics_layer_0/collision_mask = 1
sources/0 = SubResource("TileSetAtlasSource_domain_terrain")
