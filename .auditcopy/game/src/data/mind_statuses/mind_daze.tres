[gd_resource type="Resource" script_class="MindStatusDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/status/mind_status_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"mind_daze"
display_name = "Daze"
role = &"control"
description = "Reactions come late. Nothing is taken; everything is slower."
payload = {
"class": &"control",
"shape": &"slow",
"battlefield": "mind_status_mastery_slow",
"resist_stat": "mind_composure_",
"beat": 1.0,
"steepness": 0.35,
"floor_resist": 0.55,
"headroom": 0.35,
"duration": 3.0,
"magnitude_cap": 0.4,
"text": "Daze. The mind strikes first and the body answers late: reactions arrive a half-beat after the world does.",
"modifiers": [{"stat": &"attack_speed", "op": &"flat", "value": -0.18}]
}

; `attack_speed` is a RATE (`Stat.RATE_STATS`), so a FLAT is the only legal op and the
; magnitude is applied per unit: a landed daze at full magnitude slows reactions by
; 18%. The target still acts, and a target who refuses the contest at the authored
; floor refuses `floor_resist + headroom * p_land` of throws outright.