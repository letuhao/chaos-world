"beat": 1.5,
"steepness": 0.4,
"harm": 0.18,
"floor_resist": 0.4,
"headroom": 0.3,
"duration": 4.0,
"magnitude_cap": 0.2,
"text": "Voice. Not the sound of it but the claim: a sentence laid against the target's certainty, which is what composure is made of."
}
