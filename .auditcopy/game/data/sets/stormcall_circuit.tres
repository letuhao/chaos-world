[gd_resource type="Resource" script_class="SetDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/set_bonus/set_def.gd" id="1_set"]

[resource]
script = ExtResource("1_set")
id = &"stormcall_circuit"
display_name = "Stormcall Circuit"
description = "A spirit-band circuit that stores one discharge and routes it. Two members close the circuit; five conduct it."
realm = &"spirit_severing"
rarity = &"legendary"
counting = &"distinct_definition"
pieces = Array[StringName]([&"set_stormcall_circuit_bell", &"set_stormcall_circuit_mantle", &"set_stormcall_circuit_rod", &"set_stormcall_circuit_staff"])
uniques = Array[StringName]([&"unique_stormcall_thunder_seal"])
tiers = Array[Dictionary]([
	{"count": 2, "label": "Storm Pair", "options": [{"option_id": &"core_attack_spiritual", "value": 9.0}, {"option_id": &"core_max_qi", "value": 18.0}]},
	{"count": 3, "label": "Storm Circuit", "options": [{"option_id": &"core_crit_chance", "value": 0.03}, {"option_id": &"core_attack_speed", "value": 0.03}]},
	{"count": 5, "label": "Storm Conducted", "options": [{"option_id": &"core_attack_spiritual", "value": 16.0}, {"option_id": &"core_damage_reduction", "value": 0.04}, {"option_id": &"core_cultivation_rate", "value": 0.05}]},
])
