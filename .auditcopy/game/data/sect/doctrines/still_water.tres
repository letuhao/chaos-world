[ext_resource type="Script" path="res://src/modules/sect/sect_doctrine_def.gd" id="1_doctrine"]

[resource]
script = ExtResource("1_doctrine")
id = &"still_water"
display_name = "Still Water"
description = "Comprehension practised as a discipline rather than a gift. Every seat in the Jade Court sits with its breathing even because a man who cannot sit still has not yet learned to read."
teachings = Array[StringName]([&"read_a_line_slowly", &"hold_the_breath", &"separate_seeing_from_naming"])
refusals = Array[StringName]([&"unready", &"already_known"])
comprehension_floor = 5.0
comprehension_span = 60.0
affinity_floor = 20
fit_per_period = 3
teach_tax = 2.0