[resource]
script = ExtResource("1_doctrine")
id = &"iron_vine"
display_name = "The Iron Practice"
description = "Load and endurance. The Vine teaches that a body is a wall or it is weather, and which one it is today is decided by what was carried yesterday rather than by what is intended tomorrow."
