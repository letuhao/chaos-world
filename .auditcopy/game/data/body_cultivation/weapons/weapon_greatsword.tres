[gd_resource type="Resource" script_class="WeaponKindDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/body_cultivation/weapon_kind_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"greatsword"
display_name = "Greatsword"
best_against = "Armoured and braced bodies: a two-handed cut ignores a guard held square."
demand = &"mass"
lean = &"brace"
counter_demands = [&"brace", &"precision"]
counters = &"ward"
practice_gain = 1.2
# The body work one landed cut does. MASS and LEVERAGE both pay PHYSIQUE
# (WeaponDemand.PAYING_ATTRIBUTE), so greatsword and spear share a base attribute and only
# this per-use factor separates them — which is what makes the two different weapons rather
# than two sizes of one. A greatsword sets a body more than a spear thrusts it.
demand_delta = 0.9
min_realm_index = 2