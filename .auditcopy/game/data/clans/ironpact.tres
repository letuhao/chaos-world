[gd_resource type="Resource" script_class="ClanDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/clan/clan_def.gd" id="1_clan"]

[resource]
script = ExtResource("1_clan")
id = &"ironpact"
display_name = "The Ironpact"
description = "A guild-house that sells capacity: members are the muscle it rents out to whoever is paying, and it keeps a roster of names whose labour is worth more than any individual contract. It publishes a stipend, quarters and a share of contract income in exchange for standing orders — a member answers when called. It rivals the Saltledger over the harbour tariffs and answers the Quiet House at every coronation it can reach. Admission wants the household line carried far enough to be recognised as kin rather than as a stranger with a sword."
founding_bloodline = &"tideborn"
ranks = Array[StringName]([&"outer", &"inner", &"core", &"heir", &"head"])
standing_bands = Array[int]([0, 15, 40, 75, 120])
patronage = {"quarter_share": "A fixed share of every contract the house wins, paid quarterly.", "store_access": "House stores issue at cost, to any member with standing above the outer band.", "retirement_pension": "A reduced stipend is owed to a member the house can no longer call on."}
duty = {"standing_orders": "Answer a call within one day, for any employer the house names.", "armament_upkeep": "Keep your own armament current; the house does not arm its members.", "second_at_seat": "An inner member sits second in a contract negotiation and signs what they witness."}
rival_clans = Array[StringName]([&"saltledger"])
tags = Array[StringName]([&"guild", &"mercantile"])
min_purity = 0.35
required_race = &""
min_realm = 0