[ext_resource type="Script" path="res://src/modules/bloodline/bloodline_def.gd" id="1_bloodline"]

[resource]
script = ExtResource("1_bloodline")
id = &"voidborn"
display_name = "Voidborn"
description = "A line with no recorded origin and no household that will admit to it. The founding bar is set at 0.72 because the arithmetic leaves exactly one generation of pure-by-pure inheritance able to clear it: anything weaker is unobtainable by any pairing and the content would be dead. This lineage is the system's proof that its own ladder is reachable."
awaken_threshold = 0.72
percent_modifiers = {"qi_absorption": 0.10, "cultivation_rate": 0.05, "insight_gain": 0.05}
traits = Array[StringName]([&"thin_air_tolerance"])
tags = Array[StringName]([&"founding", &"disputed"])
race_id = &""