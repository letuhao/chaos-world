[gd_resource type="Resource" script_class="DestinyDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/destiny/destiny_def.gd" id="1_destiny"]

[resource]
script = ExtResource("1_destiny")
id = &"the_oath_bound"
display_name = "The Oath-Bound"
description = "Sworn into an order whose terms outlive the person who wrote them. Where the order's clerks remain, you remain."
bearing = "Your decisions were made once, in a room, in front of witnesses. Everything since has been compliance."
tier = 1
visibility = &"revealed"
grants_fates = Array[StringName]([&"oath_of_the_empty_hand"])
requires_destinies = Array[StringName]([&"the_one_who_stayed"])