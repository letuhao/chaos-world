[gd_resource type="Resource" script_class="QuestDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://src/modules/quest/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://src/modules/quest/quest_step_def.gd" id="2_step"]

[sub_resource type="Resource" id="QuestStep_account_named"]
script = ExtResource("2_step")
step_id = &"account_named"
fact = &"household_heir_registered"
need = 1
display_name = "See your name entered in a register the house opened"

[resource]
script = ExtResource("1_quest")
id = &"the_account_left_open"
display_name = "The Account You Left Open"
description = "The clan did not settle the balance against you. It settled it against the line, which is a larger target and does not get tired. A house that owes you something it cannot repay writes your name into its own register instead, and the register is where a quarrel stops being personal. You are in the book now, and a book does not expire."
kind = &"authored"
tier = 1
requirement = {}
steps = Array[ExtResource("2_step")]([SubResource("QuestStep_account_named")])
grants = Array[Dictionary]([{"kind": &"fate", "id": &"ancestral_debt_unpaid", "amount": 1}])