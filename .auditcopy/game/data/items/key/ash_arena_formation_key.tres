[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"ash_arena_formation_key"
display_name = "Arena Formation Key"
category = &"key"
rarity = &"rare"
realm = &"spirit_condensation"
## The `ash_arena_formation` puzzle's payout, and a `key` because that is what a
## formation sequence opens — the one reward the authored kit hands over that can
## then open something else. `key_reach` is the `key` category's only legal
## option, so it is what makes the def carry a channel at all.
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"key_reach", "value": 6},
])
roll_spec = {"count": 3, "contexts": ["base"]}
subcategory = &"key"
grade = &"earth"
sources = Array[StringName]([&"craft:ash_arena_formation_key_recipe"])