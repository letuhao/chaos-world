[gd_resource type="Resource" script_class="ItemDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/modules/items/item_def.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"ash_camp_pilgrims_ration"
display_name = "Pilgrim's Ration"
category = &"consumable"
rarity = &"common"
realm = &"foundation"
## A camp offering, so it feeds rather than fights: `restore_stamina` is the
## consumable channel's own resource restore and the only one a campfire answer
## can honestly claim. `foundation`/`qi_refining` puts the value inside the
## magnitude window `data audit` grades fixed values against.
fixed_modifiers = Array[Dictionary]([
	{"option_id": &"restore_stamina", "value": 5.0},
])
roll_spec = {"count": 1, "contexts": ["base", "prefix"]}
subcategory = &"food"
grade = &"mortal"
sources = Array[StringName]([&"domain:loot_ember_vault_domain"])