func test_body_work_required_matches_generator() -> void:
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.work_required, body_work_generator(index), "body R%d work_required" % (index + 1)
		)


func test_body_derived_sub_budgets_track_the_authored_budget() -> void:
	# DEF-0130: `work_required`, `acupoint_work` and `meridian_work` are no longer
	# authored lines. `BodyRealmSeed` derives them from `progress_required` and the
	# ladder index, so the seeds lost three duplicate copies of a number they
	# already carried. Nothing was dropped from the contract, but nothing in the
	# `.tres` can be read back to check the arithmetic either, so it is pinned here
	# against the same ladder the seeds are authored from.
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.acupoint_work,
			cut_budget(index, 4 * maxi(1, index)),
			"body R%d acupoint_work" % (index + 1)
		)
		assert_almost_eq(
			seed.meridian_work,
			cut_budget(index, 4 * (index + 1)),
			"body R%d meridian_work" % (index + 1)
		)


func test_body_progress_required_tracks_work_required() -> void:
	# body.progress_required and body.work_required are the same authored budget;
	# the gate is a labour budget, so the two numbers describe one thing.
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.progress_required,
			body_work_generator(index),
			"body R%d progress_required" % (index + 1)
		)


func test_body_insight_required_still_matches_its_own_ladder() -> void:
	# `body.insight_required == mind.comprehension_required == 10 + 6i + 2i^2` was
	# asserted here as a SHARED sequence. It is GONE, on purpose, and the same
	# reasoning DEF-0130 applied to `body.physique_required == qi.comprehension_required`
	# applies here: the equality was a coincidence of authoring that coincided
	# numerically at HEAD, not a balance rule. The two paths ask different questions
	# of the same number — the mind path prices mental study for its entry gate,
	# while the body's `insight_required` is both the body's own entry gate
	# (`body_cultivation/breakthrough_condition.gd:45`) AND a term in its breakthrough
	# CHANCE (`advancement.gd:62`: `0.1 + 0.01 * insight_required`). Re-pinning them
	# equal would mean dragging a second path's gate and its dice onto the mind
	# path's ladder, which is a balance ruling nobody made.
	#
	# What remains is the coverage that was real: the body's own ladder is unchanged,
	# so it is still pinned to its own generator expression. The mind side is now
	# pinned to the ladder in `test_mind_comprehension_required_matches_generator`.
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var body_seed := BodyRealmSeed.for_realm(realms[index].id)
		var expected := 10.0 + 6.0 * float(index) + 2.0 * float(index) * float(index)
		assert_almost_eq(
			body_seed.insight_required, expected, "body R%d insight_required" % (index + 1)
		)


func test_body_physique_required_matches_generator() -> void:
	# DEF-0130. This used to read `body.physique_required == qi.comprehension_required
	# == 10 + 2 * max(0, i-1)`, and that assertion is DELIBERATELY retired rather
	# than repaired. The two ladders were never one balance rule: qi's
	# `comprehension_required` prices mental study, and the body's floor prices
	# base physique. Pinning them equal was a coincidence of authoring that
	# happened to coincide numerically at HEAD - and it was numerically impossible
	# to keep while the floor did its job. DEF-0104 recorded that the ladder hands
	# out more physique on arrival than the gate asks for on 26 of 30 realms
	# (primordial_origin: 66 asked against 197.20 granted), so the floor had to be
	# re-derived as `free grant + margin`. qi's ladder rises +2 per realm; the
	# body's free grant rises with each realm's `integrity_maximum`. Those two
	# curves cannot be equal at more than a handful of realms, so holding the
	# equality would have re-broken DEF-0104 to keep an accident alive.
	#
	# What replaces it is the invariant the coupling was standing in for: the
	# floor must be a floor the player can actually be under, which means it must
	# sit strictly ABOVE everything the ladder grants on arrival.
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.physique_required,
			body_physique_required_generator(index),
			"body R%d physique_required" % (index + 1)
		)


func test_body_physique_gate_clears_what_the_ladder_grants_for_free() -> void:
	# The gate-soundness half of the assertion above, checked against the seeds
	# rather than the formula, so it cannot be satisfied by a formula and a seed
	# that agree with each other and not with the runtime.
	# `BodyBreakthroughCondition` compares base PHYSIQUE against the floor, and
	# the only base-physique writers are the breakthrough reward and the
	# milestone bonus (`BodyProgress.grant`), so arrival physique is fully
	# determined by the ladder. Mirrors `tools/cultivation/audit.py`.
	var realms := RealmDefaults.ladder().realms()
	var granted := 0.0
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_eq(
			seed.physique_required > granted,
			true,
			(
				"body R%d physique floor %.2f is above the %.2f granted on arrival"
				% [index + 1, seed.physique_required, granted]
			)
		)
		granted += float(seed.rewards.get("physique", 0.0))
		granted += seed.integrity_maximum * MILESTONE_PHYSIQUE_RATIO


func test_body_quality_ladders_match_generator() -> void:
	# The quality ceiling, the entry gate a fixed headroom below it, and the
	# reservoir target above it. Before the retune the gate WAS the ceiling, which
	# pinned average huyệt quality at the moment of an attempt to a single number
	# and made acupoint quality unable to enter the roll anywhere.
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.quality_target,
			quality_ceiling_generator(index),
			"body R%d quality_target" % (index + 1)
		)
		assert_almost_eq(
			seed.quality_required,
			quality_gate_generator(index),
			"body R%d quality_required" % (index + 1)
		)
		assert_almost_eq(
			seed.integrity_target,
			integrity_target_generator(index),
			"body R%d integrity_target" % (index + 1)
		)


func test_body_chance_band_matches_generator_and_stays_live() -> void:
	# `BodyAdvancement._chance` is `chance_base + quality * 0.5` clamped to
	# `chance_cap`, so a cap that is not strictly above `base + quality*0.5` at the
	# top of the span an actor can hold swallows the huyệt term. DEF-0079 recorded
	# exactly that on five realms. Assert both the recipe and the property.
	var realms := RealmDefaults.ladder().realms()
	for index in range(realms.size()):
		var seed := BodyRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.chance_base, chance_base_generator(index), "body R%d chance_base" % (index + 1)
		)
		assert_almost_eq(
			seed.chance_cap, chance_cap_generator(index), "body R%d chance_cap" % (index + 1)
		)
		# The span is the gate up to the previous realm's ceiling, because that is
		# what an actor entering this realm can actually be holding.
		var reach := seed.quality_target
		if index > 0:
			reach = BodyRealmSeed.for_realm(realms[index - 1].id).quality_target
		var worst := minf(seed.chance_base + 0.5 * seed.quality_required, seed.chance_cap)
		var best := minf(seed.chance_base + 0.5 * reach, seed.chance_cap)
		assert_eq(best > worst, true, "body R%d has a live chance band" % (index + 1))


func test_body_first_step_moves_the_labour_budget_by_two() -> void:
	# R1 -> R2 moves the body's labour budget by exactly two labour units. The
	# retune did not touch `BODY_WORK_REQUIRED`, so this is still the same
	# invariant it always was; only the way the budget is published to the seed
	# changed (`work_required` is derived, `progress_required` is the authored
	# line). `progress_required` is asserted here rather than the derived alias
	# so the check reads the authored data.
	var r1 := BodyRealmSeed.for_realm(&"qi_refining")
	var r2 := BodyRealmSeed.for_realm(&"foundation")
	assert_almost_eq(r2.progress_required, r1.progress_required + 2.0, "body R1->R2 step is +2")


# --- Step ratios the technique ladder is sized against ----------------------


func test_qi_progress_step_ratio_floor_is_pinned() -> void:
	# DEF-0083 / ADR 0055: the technique learning-cost ladder is sized so its
	# per-realm step stays at or below the qi's work-budget step. The tightest
	# step on the strictly rising part of the qi ladder is R29 -> R30.
	#
	# The scan starts at R2. R1 -> R2 is deliberately flat (both are 100), so its
	# ratio is 1.0 and it is not a work-budget step - including it would measure
	# an authoring artifact instead of the ladder the technique system is sized
	# against. R2 -> R3 is the 2.0x jump off the flat, which is likewise not the
	# tightest step.
	var realms := RealmDefaults.ladder().realms()
	var worst_ratio := INF
	var worst_label := ""
	for index in range(3, realms.size()):
		var previous := QiRealmSeed.for_realm(realms[index - 1].id).progress_required
		var current := QiRealmSeed.for_realm(realms[index].id).progress_required
		var ratio := current / previous
		if ratio < worst_ratio:
			worst_ratio = ratio
			worst_label = "%s->%s" % [realms[index - 1].id, realms[index].id]
	# The floor is measured at R29 -> R30 (dao_ancestor -> primordial_origin).
	assert_eq(worst_label, "dao_ancestor->primordial_origin", "tightest step is R29->R30")
	assert_almost_eq(
		worst_ratio, QI_R29_R30_STEP, "minimum qi step ratio (%s)" % worst_label, STEP_RATIO_EPSILON
	)
	# ADR 0055's published floor. The shipped value is 1.0357142857142858, so
	# 1.035714 is the 6dp truncation of it and the floor is a "at or above"
	# bound, not an equality: a technique step may be this tight or looser, but
	# never tighter than the qi work budget it is paid out of.
	var at_or_above_floor := worst_ratio >= ADR_0055_QI_STEP_FLOOR
	assert_eq(at_or_above_floor, true, "qi step ratio stays at or above the ADR 0055 floor")


func test_qi_progress_step_ratio_only_ever_tightens() -> void:
	# On a linear 100 * i ladder the per-realm step ratio is (i+1)/i, so it falls
	# monotonically toward the top and its minimum is necessarily the last step.
	# If this ordering inverts, a realm has been re-authored out of order and the
	# ladder is no longer linear, which is what would move the ADR 0055 floor.
	var realms := RealmDefaults.ladder().realms()
	for index in range(4, realms.size()):
		var before_previous := QiRealmSeed.for_realm(realms[index - 2].id).progress_required
		var previous := QiRealmSeed.for_realm(realms[index - 1].id).progress_required
		var current := QiRealmSeed.for_realm(realms[index].id).progress_required
		var previous_ratio := previous / before_previous
		var ratio := current / previous
		var tightens := ratio <= previous_ratio + STEP_RATIO_EPSILON
		assert_eq(tightens, true, "qi step ratio tightens at R%d" % (index + 1))


func test_qi_progress_ladder_is_exactly_linear_above_r2() -> void:
	# Above R2 the ladder is 100 * i with no curve at all. This is the property
	# that makes the 1.035714 step the floor rather than an accident of one realm.
	var realms := RealmDefaults.ladder().realms()
	for index in range(2, realms.size()):
		var seed := QiRealmSeed.for_realm(realms[index].id)
		assert_almost_eq(
			seed.progress_required, 100.0 * float(index), "qi R%d is exactly 100*i" % (index + 1)
		)
